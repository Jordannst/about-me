---
// SmoothScroll.astro - Lenis Smooth Scroll Integration
// Provides buttery smooth scrolling with momentum
---

<script>
  import Lenis from 'lenis';

  type LenisInstance = InstanceType<typeof Lenis>;

  function getHashTarget(hash: string) {
    if (!hash || hash === '#') return null;

    try {
      return document.querySelector<HTMLElement>(hash);
    } catch {
      return document.getElementById(decodeURIComponent(hash.slice(1)));
    }
  }

  function initSmoothScroll() {
    (window as any).__smoothScrollCleanup?.();

    const controller = new AbortController();
    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopPointerQuery = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 768px)');
    const reduceMotion = reduceMotionQuery.matches;
    const canUseLenis = desktopPointerQuery.matches && !reduceMotion;
    let lenis: LenisInstance | null = null;
    let rafId = 0;
    let hashTimeoutId = 0;

    const startRaf = () => {
      if (!lenis || rafId) return;

      const raf = (time: number) => {
        lenis?.raf(time);
        rafId = requestAnimationFrame(raf);
      };

      rafId = requestAnimationFrame(raf);
    };

    const stopRaf = () => {
      if (!rafId) return;
      cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const scrollToTarget = (target: HTMLElement) => {
      if (lenis) {
        lenis.scrollTo(target, {
          offset: 0,
          duration: 1.5,
        });
        return;
      }

      target.scrollIntoView({
        behavior: reduceMotion ? 'auto' : 'smooth',
        block: 'start',
      });
    };

    if (canUseLenis) {
      lenis = new Lenis({
        duration: 1.0,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.2,
      });

      (window as any).lenis = lenis;
      startRaf();
    } else {
      (window as any).lenis = null;
    }

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target as Element | null;
        const anchor = target?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
        const hash = anchor?.getAttribute('href');
        if (!anchor || !hash || hash === '#') return;

        const scrollTarget = getHashTarget(hash);
        if (!scrollTarget) return;

        event.preventDefault();
        scrollToTarget(scrollTarget);
      },
      { signal: controller.signal },
    );

    const scrollToCurrentHash = () => {
      const target = getHashTarget(window.location.hash);
      if (!target) return;

      if (hashTimeoutId) window.clearTimeout(hashTimeoutId);
      hashTimeoutId = window.setTimeout(() => {
        hashTimeoutId = 0;
        scrollToTarget(target);
      }, 100);
    };

    if (document.readyState === 'complete') {
      scrollToCurrentHash();
    } else {
      window.addEventListener('load', scrollToCurrentHash, { once: true, signal: controller.signal });
    }

    window.addEventListener('hashchange', scrollToCurrentHash, { signal: controller.signal });

    document.addEventListener(
      'visibilitychange',
      () => {
        if (!lenis) return;

        if (document.hidden) {
          lenis.stop();
          stopRaf();
        } else {
          lenis.start();
          startRaf();
        }
      },
      { signal: controller.signal },
    );

    const reinit = () => initSmoothScroll();
    desktopPointerQuery.addEventListener('change', reinit, { signal: controller.signal });
    reduceMotionQuery.addEventListener('change', reinit, { signal: controller.signal });

    const cleanup = () => {
      controller.abort();
      if (hashTimeoutId) window.clearTimeout(hashTimeoutId);
      stopRaf();
      lenis?.destroy();
      if ((window as any).lenis === lenis) {
        (window as any).lenis = null;
      }
      lenis = null;
      (window as any).__smoothScrollCleanup = null;
    };

    (window as any).__smoothScrollCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true, signal: controller.signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSmoothScroll, { once: true });
  } else {
    initSmoothScroll();
  }

  if (!(window as any).__smoothScrollAfterSwapBound) {
    document.addEventListener('astro:after-swap', initSmoothScroll);
    (window as any).__smoothScrollAfterSwapBound = true;
  }
</script>

<style is:global>
  html.lenis, html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }
</style>
