---
import { personal } from '../data/portfolio';

const firstName = personal.name.split(' ')[0];
const letters = firstName.split('');
---

<!-- Signature Loading Screen -->
<div id="loading-screen" class="loading-screen fixed inset-0 z-[100] bg-[var(--bg-primary)]">
  <div class="loading-content" aria-label="Loading">
    <div class="loading-signature" aria-label={firstName}>
      {letters.map((letter, index) => (
        <span class="loading-letter" style={`--letter-index:${index}`}>{letter}</span>
      ))}
      <span class="loading-dot" aria-hidden="true">.</span>
    </div>

    <div class="loading-line-container" aria-hidden="true">
      <div class="loading-line"></div>
    </div>
  </div>
</div>

<style>
  .loading-screen {
    overflow: hidden;
    color: var(--text-primary);
    clip-path: inset(0 0 0 0);
    transition: opacity 700ms var(--ease-luxury);
    display: grid;
    place-items: center;
  }

  .loading-screen::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--bg-primary);
  }

  .loading-content {
    display: grid;
    place-items: center;
    gap: 0.9rem;
    padding: 2rem;
    transform: translateY(-0.25rem);
  }

  .loading-signature {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 4.8vw, 3.2rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .loading-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: loadingLetter 720ms var(--ease-luxury) forwards;
    animation-delay: calc(120ms + var(--letter-index) * 48ms);
  }

  .loading-dot {
    display: inline-block;
    color: var(--accent);
    opacity: 0;
    transform: scale(0.3);
    animation: loadingDot 680ms var(--ease-luxury) forwards;
    animation-delay: 500ms;
    transform-origin: center;
  }

  .loading-line-container {
    position: relative;
    width: min(8.5rem, 42vw);
    height: 1px;
    overflow: hidden;
    background: var(--border-color);
    opacity: 0;
    transform: scaleX(0.72);
    animation: loadingLineIn 640ms var(--ease-luxury) 280ms forwards;
    transform-origin: center;
  }

  .loading-line-container::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 30%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 90%, white 10%), transparent);
    transform: translateX(-100%);
    animation: loadingScan 980ms var(--ease-luxury) 520ms infinite;
  }

  .loading-line {
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: loadingProgress 1500ms var(--ease-luxury) 360ms forwards;
  }

  @keyframes loadingLetter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes loadingDot {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    60% {
      opacity: 1;
      transform: scale(1.18);
      text-shadow: 0 0 1rem color-mix(in srgb, var(--accent) 48%, transparent);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      text-shadow: 0 0 0 transparent;
    }
  }

  @keyframes loadingLineIn {
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes loadingProgress {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(0.7);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes loadingScan {
    to {
      transform: translateX(420%);
    }
  }

  #loading-screen.loaded {
    pointer-events: none;
    animation: loadingCurtainExit 720ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  #loading-screen.loaded .loading-content {
    opacity: 0;
    transform: translateY(-0.8rem);
    transition:
      opacity 220ms ease-out,
      transform 420ms var(--ease-luxury);
  }

  @keyframes loadingCurtainExit {
    0% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen,
    .loading-screen *,
    .loading-screen *::before,
    .loading-screen *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .loading-letter,
    .loading-dot,
    .loading-line-container {
      opacity: 1;
      transform: none;
    }

    .loading-line {
      transform: scaleX(1);
    }
  }
</style>

<script>
  // Loading screen controller - event-based detection
  document.addEventListener('DOMContentLoaded', () => {
    const loadingScreen = document.getElementById('loading-screen');
    const mainContent = document.querySelector('main');
    let hasHidden = false;
    
    const hideLoader = () => {
      if (hasHidden) return;
      hasHidden = true;
      
      if (loadingScreen) {
        loadingScreen.classList.add('loaded');
        setTimeout(() => {
          loadingScreen.style.display = 'none';
        }, 900);
      }
      
      if (mainContent) {
        mainContent.classList.add('content-revealed');
      }
    };
    
    // Event-based: wait for all critical resources
    if (document.readyState === 'complete') {
      // Already loaded, hide after minimum animation time
      setTimeout(hideLoader, 800);
    } else {
      // Wait for window load (fonts, images, etc.)
      window.addEventListener('load', () => {
        // Ensure minimum animation duration for UX (loading line is 1.8s)
        setTimeout(hideLoader, 800);
      });
      
      // Safety fallback - never block longer than 4 seconds
      setTimeout(hideLoader, 2500); // safety fallback
    }
  });

  // SPA navigations swap in a fresh copy of this overlay — kill it instantly.
  // The loading experience belongs to the first visit only; in-app navigation
  // is handled by PageTransition's curtain.
  document.addEventListener('astro:after-swap', () => {
    const loadingScreen = document.getElementById('loading-screen');
    if (loadingScreen) loadingScreen.style.display = 'none';
    document.querySelector('main')?.classList.add('content-revealed');
  });
</script>
