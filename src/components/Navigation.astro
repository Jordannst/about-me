---
import { personal, social } from '../data/portfolio';
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="fixed top-0 left-0 right-0 z-30 bg-[var(--bg-primary)]/90 backdrop-blur-sm transition-colors duration-700">
  <div class="max-w-[1600px] mx-auto px-6 md:px-16">
    <div class="flex items-center justify-between h-16 md:h-20 border-b border-[var(--border-color)]">
      <!-- Logo -->
      <a href="/" class="block">
        <img src="/logo.png" alt={personal.name} class="h-8 md:h-10 w-auto" />
      </a>
      
      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center gap-12">
        <a href="#about" class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500">
          About
        </a>
        <a href="#work" class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500">
          Work
        </a>
        <a href="#skills" class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500">
          Skills
        </a>
        <a href="#contact" class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500">
          Contact
        </a>
      </div>

      <!-- Right Side: Social + Theme Toggle + Mobile Menu -->
      <div class="flex items-center gap-4 md:gap-6">
        <!-- Social Links (Desktop) -->
        <a href={social.github} target="_blank" rel="noopener" class="hidden md:block text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
        </a>
        <a href={social.linkedin} target="_blank" rel="noopener" class="hidden md:block text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect width="4" height="12" x="2" y="9"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        
        <!-- Theme Toggle -->
        <div class="border-l border-[var(--border-color)] pl-4 md:pl-6">
          <ThemeToggle />
        </div>
        
        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn" 
          class="md:hidden p-2 text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors duration-300"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-20 bg-[var(--bg-primary)] opacity-0 pointer-events-none transition-opacity duration-500 md:hidden">
  <div class="flex flex-col items-center justify-center h-full pt-16">
    <!-- Mobile Nav Links -->
    <nav class="flex flex-col items-center gap-8">
      <a href="#about" class="mobile-nav-link text-2xl font-[family-name:var(--font-serif)] text-[var(--text-primary)] hover:text-[var(--accent)] transition-all duration-500" data-index="0">
        About
      </a>
      <a href="#work" class="mobile-nav-link text-2xl font-[family-name:var(--font-serif)] text-[var(--text-primary)] hover:text-[var(--accent)] transition-all duration-500" data-index="1">
        Work
      </a>
      <a href="#skills" class="mobile-nav-link text-2xl font-[family-name:var(--font-serif)] text-[var(--text-primary)] hover:text-[var(--accent)] transition-all duration-500" data-index="2">
        Skills
      </a>
      <a href="#contact" class="mobile-nav-link text-2xl font-[family-name:var(--font-serif)] text-[var(--text-primary)] hover:text-[var(--accent)] transition-all duration-500" data-index="3">
        Contact
      </a>
    </nav>
    
    <!-- Mobile Social Links -->
    <div class="flex items-center gap-6 mt-12 pt-8 border-t border-[var(--border-color)]">
      <a href={social.github} target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
      </a>
      <a href={social.linkedin} target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect width="4" height="12" x="2" y="9"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href={social.instagram} target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Mobile nav link animation */
  .mobile-nav-link {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 500ms ease, transform 500ms ease, color 300ms ease;
  }
  
  #mobile-menu.open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }
  
  #mobile-menu.open .mobile-nav-link[data-index="0"] { transition-delay: 100ms; }
  #mobile-menu.open .mobile-nav-link[data-index="1"] { transition-delay: 200ms; }
  #mobile-menu.open .mobile-nav-link[data-index="2"] { transition-delay: 300ms; }
  #mobile-menu.open .mobile-nav-link[data-index="3"] { transition-delay: 400ms; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    
    let isOpen = false;
    
    function toggleMenu() {
      isOpen = !isOpen;
      
      if (isOpen) {
        mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'open');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        menuBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'open');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }
    
    menuBtn?.addEventListener('click', toggleMenu);
    
    // Close menu when clicking nav links
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  });
</script>
