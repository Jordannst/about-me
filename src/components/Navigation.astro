---
import { navLinks, personal } from '../data/portfolio';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="fixed top-0 left-0 right-0 z-30 bg-[var(--bg-primary)]/90 backdrop-blur-sm transition-colors duration-700">
  <div class="max-w-[1600px] mx-auto px-6 md:px-16">
    <div class="flex items-center justify-between h-16 md:h-20 border-b border-[var(--border-color)]">
      <!-- Logo -->
      <a href="/" class="block">
        <img src="/logo.webp" alt={personal.name} class="h-16 md:h-20 w-auto" width="80" height="80" />
      </a>
      
      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center gap-12">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] hover:text-[var(--accent-text)] transition-colors duration-500" data-text={link.label}>
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right Side: Social + Theme Toggle + Mobile Menu -->
      <div class="flex items-center gap-4 md:gap-6">
        <!-- Social Links (Desktop) -->
        <SocialLinks
          size={18}
          networks={['github', 'linkedin']}
          class="hidden md:block text-[var(--text-secondary)] hover:text-[var(--accent-text)] transition-colors duration-500"
        />
        
        <!-- Theme Toggle -->
        <div class="border-l border-[var(--border-color)] pl-4 md:pl-6">
          <ThemeToggle />
        </div>
        
        <button 
          id="mobile-menu-btn" 
          class="md:hidden p-4 -mr-2 text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors duration-300"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-20 bg-[var(--bg-primary)] opacity-0 pointer-events-none transition-opacity duration-500 md:hidden">
  <div class="flex flex-col items-center justify-center min-h-[100dvh] pt-16">
    <!-- Mobile Nav Links -->
    <nav class="flex flex-col items-center gap-8">
      {navLinks.map((link, index) => (
        <a href={link.href} class="mobile-nav-link text-2xl font-[family-name:var(--font-serif)] text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors duration-500" data-index={index}>
          {link.label}
        </a>
      ))}
    </nav>
    
    <!-- Mobile Social Links -->
    <div class="flex items-center gap-6 mt-12 pt-8 border-t border-[var(--border-color)]">
      <SocialLinks
        size={24}
        class="text-[var(--text-secondary)] hover:text-[var(--accent-text)] transition-colors duration-500"
      />
    </div>
  </div>
</div>

<style>
  /* Nav link scramble effect */
  .nav-link {
    position: relative;
    display: inline-block;
  }

  #mobile-menu {
    min-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.4s var(--ease-luxury);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover::after {
      transform: scaleX(1);
    }
  }

  /* Mobile nav link animation */
  .mobile-nav-link {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 500ms var(--ease-luxury),
      transform 500ms var(--ease-luxury),
      color 300ms var(--ease-luxury);
  }
  
  #mobile-menu.open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }
  
  #mobile-menu.open .mobile-nav-link[data-index="0"] { transition-delay: 100ms; }
  #mobile-menu.open .mobile-nav-link[data-index="1"] { transition-delay: 200ms; }
  #mobile-menu.open .mobile-nav-link[data-index="2"] { transition-delay: 300ms; }
  #mobile-menu.open .mobile-nav-link[data-index="3"] { transition-delay: 400ms; }
</style>

<script>
  function initNavigation() {
    (window as any).__navigationCleanup?.();

    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const desktopNavLinks = document.querySelectorAll('.nav-link');
    const controller = new AbortController();
    
    let isOpen = false;
    let previousBodyOverflow = '';
    const scrambleTimers = new Map<Element, number>();

    // Text scramble effect for desktop nav links
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    
    desktopNavLinks.forEach(link => {
      const originalText = link.getAttribute('data-text') || link.textContent?.trim() || '';
      
      link.addEventListener('mouseenter', () => {
        let iteration = 0;
        const existingTimer = scrambleTimers.get(link);
        if (existingTimer) window.clearInterval(existingTimer);
        
        const timer = window.setInterval(() => {
          link.textContent = originalText
            .split('')
            .map((char, index) => {
              if (index < iteration) return originalText[index];
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');
          
          if (iteration >= originalText.length) {
            window.clearInterval(timer);
            scrambleTimers.delete(link);
          }
          iteration += 1 / 2;
        }, 30);
        scrambleTimers.set(link, timer);
      }, { signal: controller.signal });
      
      link.addEventListener('mouseleave', () => {
        const existingTimer = scrambleTimers.get(link);
        if (existingTimer) window.clearInterval(existingTimer);
        scrambleTimers.delete(link);
        link.textContent = originalText;
      }, { signal: controller.signal });
    });
    
    function setMenuOpen(nextOpen: boolean) {
      if (isOpen === nextOpen) return;
      isOpen = nextOpen;

      if (isOpen) {
        mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'open');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        menuBtn?.setAttribute('aria-expanded', 'true');
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        (window as any).lenis?.stop?.();
      } else {
        mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'open');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = previousBodyOverflow;
        (window as any).lenis?.start?.();
      }
    }

    function toggleMenu() {
      setMenuOpen(!isOpen);
    }
    
    menuBtn?.addEventListener('click', toggleMenu, { signal: controller.signal });
    
    // Close menu when clicking nav links
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
      }, { signal: controller.signal });
    });

    const cleanup = () => {
      setMenuOpen(false);
      scrambleTimers.forEach((timer) => window.clearInterval(timer));
      scrambleTimers.clear();
      controller.abort();
      (window as any).__navigationCleanup = null;
    };

    (window as any).__navigationCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true, signal: controller.signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation, { once: true });
  } else {
    initNavigation();
  }

  if (!(window as any).__navigationAfterSwapBound) {
    document.addEventListener('astro:after-swap', initNavigation);
    (window as any).__navigationAfterSwapBound = true;
  }
</script>
