---
// Theme Toggle Component
// Best practices: System preference + Manual toggle + localStorage persistence
---

<button
  id="theme-toggle"
  class="theme-toggle text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500"
  aria-label="Toggle dark mode"
  title="Toggle theme"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2"/>
    <path d="M12 20v2"/>
    <path d="m4.93 4.93 1.41 1.41"/>
    <path d="m17.66 17.66 1.41 1.41"/>
    <path d="M2 12h2"/>
    <path d="M20 12h2"/>
    <path d="m6.34 17.66-1.41 1.41"/>
    <path d="m19.07 4.93-1.41 1.41"/>
  </svg>
  
  <!-- Moon icon (shown in light mode) -->
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>

<script>
  type ThemeName = 'light' | 'dark';

  const THEME_KEY = 'theme-preference';

  function readStoredTheme(): ThemeName | null {
    try {
      const stored = localStorage.getItem(THEME_KEY);
      return stored === 'light' || stored === 'dark' ? stored : null;
    } catch {
      return null;
    }
  }

  function writeStoredTheme(theme: ThemeName) {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // Theme still changes even when storage is unavailable.
    }
  }

  function getThemePreference(): ThemeName {
    const stored = readStoredTheme();
    if (stored) {
      return stored;
    }

    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: ThemeName, persist = true) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    if (persist) writeStoredTheme(theme);
  }

  function getOppositeTheme(): ThemeName {
    return document.documentElement.classList.contains('dark') ? 'light' : 'dark';
  }

  function getRevealOrigin(toggle: HTMLElement) {
    const rect = toggle.getBoundingClientRect();
    return {
      x: rect.left + rect.width / 2,
      y: rect.top + rect.height / 2,
    };
  }

  function requestThemeChange(toggle: HTMLElement, theme: ThemeName) {
    const { x, y } = getRevealOrigin(toggle);

    window.dispatchEvent(new CustomEvent('portfolio:theme-change-request', {
      detail: { theme, x, y },
    }));
  }

  function initThemeToggle() {
    (window as any).__themeToggleCleanup?.();

    const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
    const controller = new AbortController();
    const systemThemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
    let switchingTimeout = 0;

    (window as any).__portfolioTheme = {
      applyTheme: (theme: ThemeName) => applyTheme(theme, true),
    };
    applyTheme(getThemePreference(), false);

    const clearSwitchingState = () => {
      if (switchingTimeout) window.clearTimeout(switchingTimeout);
      switchingTimeout = 0;
      if (toggle) {
        toggle.disabled = false;
        toggle.classList.remove('is-switching');
      }
    };

    toggle?.addEventListener('click', () => {
      if (toggle.disabled) return;

      clearSwitchingState();
      toggle.classList.add('is-switching');
      toggle.disabled = true;
      requestThemeChange(toggle, getOppositeTheme());
      switchingTimeout = window.setTimeout(clearSwitchingState, 900);
    }, { signal: controller.signal });

    window.addEventListener('portfolio:theme-reveal-end', clearSwitchingState, { signal: controller.signal });

    systemThemeQuery.addEventListener('change', (event) => {
      if (!readStoredTheme()) {
        applyTheme(event.matches ? 'dark' : 'light', false);
      }
    }, { signal: controller.signal });

    const cleanup = () => {
      controller.abort();
      clearSwitchingState();
      (window as any).__themeToggleCleanup = undefined;
    };

    (window as any).__themeToggleCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true, signal: controller.signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle, { once: true });
  } else {
    initThemeToggle();
  }

  if (!(window as any).__themeToggleAfterSwapBound) {
    document.addEventListener('astro:after-swap', initThemeToggle);
    (window as any).__themeToggleAfterSwapBound = true;
  }
</script>
