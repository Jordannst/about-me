---

<div id="scroll-progress-container" class="fixed top-0 left-0 w-full h-1 z-[100] pointer-events-none">
  <div
    id="scroll-progress-bar"
    class="h-full w-full bg-[var(--accent)] origin-left"
    style="box-shadow: 0 0 10px var(--accent); transform: scaleX(0);"
  ></div>
</div>

<script>
  // Progress bar scales on transform only (no width/layout work) and the
  // element is re-queried per frame, so it keeps working after SPA swaps.
  function updateScrollProgress() {
    const scrollBar = document.getElementById('scroll-progress-bar');
    if (!scrollBar) return;

    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const scrollable = documentHeight - windowHeight;
    const progress = scrollable > 0 ? Math.min(scrollTop / scrollable, 1) : 0;

    scrollBar.style.transform = `scaleX(${progress})`;
  }

  let ticking = false;
  const handleScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        updateScrollProgress();
        ticking = false;
      });
      ticking = true;
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  document.addEventListener('astro:after-swap', updateScrollProgress);

  updateScrollProgress();
</script>
