---
import { personal, meta, social } from '../data/portfolio';
---

<!-- Big Footer with CTA -->
<footer class="bg-[var(--bg-inverted)] text-[var(--text-inverted)] overflow-hidden">
  <!-- Marquee Strip -->
  <div class="footer-marquee border-b border-current/10 py-3 overflow-hidden" aria-hidden="true">
    <div class="footer-marquee-track">
      <span class="footer-marquee-text">AVAILABLE FOR FREELANCE — LET'S COLLABORATE — OPEN TO OPPORTUNITIES — CREATIVE DEVELOPMENT — </span>
      <span class="footer-marquee-text">AVAILABLE FOR FREELANCE — LET'S COLLABORATE — OPEN TO OPPORTUNITIES — CREATIVE DEVELOPMENT — </span>
    </div>
  </div>

  <!-- Big CTA Section -->
  <div class="py-20 md:py-32 lg:py-40 px-8 md:px-16">
    <div class="max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <!-- Left: Big Headline -->
        <div class="lg:col-span-8">
          <p class="text-xs uppercase tracking-[0.25em] opacity-50 mb-6 reveal-fade-up">
            Have a project in mind?
          </p>
          <h2 class="text-5xl md:text-7xl lg:text-[7rem] xl:text-[8rem] leading-[0.85] reveal-fade-up" style="transition-delay: 150ms;">
            Let's create
            <br />
            <span class="something-wrapper">
              <svg 
                id="something-svg" 
                class="something-svg" 
                viewBox="0 0 580 100" 
                xmlns="http://www.w3.org/2000/svg"
                aria-label="something"
              >
                <text 
                  x="0" 
                  y="78" 
                  class="something-text"
                  font-family="'Playfair Display', serif"
                  font-style="italic"
                  font-weight="400"
                  font-size="90"
                >something</text>
              </svg>
              <span class="sr-only">something</span>
            </span>
            <br />
            amazing<span class="text-[var(--accent)]">.</span>
          </h2>
        </div>

        <!-- Right: CTA Button -->
        <div class="lg:col-span-4 lg:text-right reveal-fade-up" style="transition-delay: 300ms;">
          <a 
            href={`mailto:${personal.email}`}
            class="footer-cta-btn inline-flex items-center gap-4 group"
          >
            <span class="footer-cta-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform duration-500 group-hover:rotate-45">
                <path d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </span>
            <span class="text-xs uppercase tracking-[0.2em]">Get in Touch</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-current/10 py-8 px-8 md:px-16">
    <div class="max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <!-- Logo -->
        <div>
          <a href="/" class="font-[family-name:var(--font-serif)] text-xl tracking-tight hover:text-[var(--accent)] transition-colors duration-500">
            {personal.name.split(' ')[0]}<span class="text-[var(--accent)]">.</span>
          </a>
        </div>

        <!-- Navigation -->
        <nav class="flex flex-wrap gap-6 md:justify-center">
          <a href="#about" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            About
          </a>
          <a href="#work" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Work
          </a>
          <a href="#skills" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Skills
          </a>
          <a href="#contact" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Contact
          </a>
        </nav>

        <!-- Social + Copyright -->
        <div class="flex flex-col md:items-end gap-4">
          <div class="flex items-center gap-5">
            <a href={social.github} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </a>
            <a href={social.linkedin} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect width="4" height="12" x="2" y="9"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
            <a href={social.instagram} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          </div>
          <p class="text-[9px] uppercase tracking-[0.2em] opacity-30">
            © {meta.year} {personal.name}. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer Marquee */
  .footer-marquee-track {
    display: flex;
    width: fit-content;
    animation: footerMarquee 25s linear infinite;
  }

  .footer-marquee-text {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    opacity: 0.3;
    white-space: nowrap;
    flex-shrink: 0;
    padding-right: 1rem;
  }

  @keyframes footerMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* CTA Circle Button */
  .footer-cta-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .footer-cta-btn:hover .footer-cta-circle {
    background-color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-marquee-track {
      animation: none;
    }
    .something-text {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      fill-opacity: 1 !important;
    }
  }

  /* SVG Handwriting Animation */
  .something-wrapper {
    display: inline-block;
    vertical-align: baseline;
    position: relative;
    line-height: 0.85;
  }

  .something-svg {
    display: inline-block;
    height: 0.95em;
    width: auto;
    overflow: visible;
    vertical-align: baseline;
    position: relative;
    top: 0.02em;
  }

  .something-text {
    fill: var(--accent);
    fill-opacity: 0;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHandwritingAnimation() {
    const svg = document.getElementById('something-svg');
    if (!svg) return;

    const textEl = svg.querySelector('.something-text') as SVGTextElement;
    if (!textEl) return;

    // Get the total length of the text path
    const length = (textEl as any).getComputedTextLength() * 3.5;

    // Set initial stroke-dash state
    gsap.set(textEl, {
      strokeDasharray: length,
      strokeDashoffset: length,
      fillOpacity: 0,
    });

    // Create the timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: svg,
        start: 'top 80%',
        toggleActions: 'play none none none',
      },
    });

    // Phase 1: Draw the stroke (handwriting effect)
    tl.to(textEl, {
      strokeDashoffset: 0,
      duration: 2,
      ease: 'power2.inOut',
    });

    // Phase 2: Fill in the text
    tl.to(textEl, {
      fillOpacity: 1,
      duration: 0.6,
      ease: 'power1.in',
    }, '-=0.4');

    // Phase 3: Fade out the stroke
    tl.to(textEl, {
      strokeWidth: 0,
      duration: 0.5,
      ease: 'power1.out',
    }, '-=0.3');
  }

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(initHandwritingAnimation, 300);
  });
  document.addEventListener('astro:after-swap', () => {
    setTimeout(initHandwritingAnimation, 300);
  });
</script>
