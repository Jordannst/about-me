---
import { personal, meta, social } from '../data/portfolio';
---

<!-- Footer uses inverted colors (always dark background) -->
<footer class="py-12 md:py-16 px-8 md:px-16 bg-[var(--bg-inverted)] text-[var(--text-inverted)]">
  <div class="max-w-[1600px] mx-auto">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 border-t border-current/10 pt-12">
      <!-- Logo -->
      <a href="/" class="font-[family-name:var(--font-serif)] text-xl tracking-tight hover:text-[var(--accent)] transition-colors duration-500">
        {personal.name.split(' ')[0]}
        <span class="text-[var(--accent)]">.</span>
      </a>

      <!-- Navigation -->
      <div class="flex flex-wrap gap-6 md:gap-12">
        <a href="#about" class="text-xs uppercase tracking-[0.25em] opacity-60 hover:text-[var(--accent)] hover:opacity-100 transition-all duration-500">
          About
        </a>
        <a href="#work" class="text-xs uppercase tracking-[0.25em] opacity-60 hover:text-[var(--accent)] hover:opacity-100 transition-all duration-500">
          Work
        </a>
        <a href="#skills" class="text-xs uppercase tracking-[0.25em] opacity-60 hover:text-[var(--accent)] hover:opacity-100 transition-all duration-500">
          Skills
        </a>
        <a href="#contact" class="text-xs uppercase tracking-[0.25em] opacity-60 hover:text-[var(--accent)] hover:opacity-100 transition-all duration-500">
          Contact
        </a>
      </div>

      <!-- Copyright -->
      <p class="text-[10px] uppercase tracking-[0.2em] opacity-40">
        © {meta.year} {personal.name}
      </p>
    </div>
  </div>
</footer>
