---
// PageTransition.astro — curtain transition between pages, driven by Astro's
// ClientRouter lifecycle instead of intercepting clicks.
//
// How it works:
//   astro:before-preparation → wrap the router's loader so navigation waits
//     for BOTH the page fetch and the ~500ms cover animation (whichever is
//     slower — usually the animation, since pages are static).
//   astro:after-swap → play the uncover animation over the new page.
//
// transition:persist keeps this exact DOM node across swaps so the overlay
// stays covering the screen while the body underneath is replaced.
// Reduced motion: no curtain at all — the router swaps instantly.
---

<div id="page-transition" class="page-transition" transition:persist="page-transition">
  <div class="transition-overlay"></div>
  <svg class="transition-curve" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path class="curve-path" d="M0,100 Q50,100 100,100 L100,100 L0,100 Z" />
  </svg>
</div>

<style>
  .page-transition {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  .transition-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--bg-inverted);
    transform: translateY(100%);
  }

  .transition-curve {
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    height: 150px;
    fill: var(--bg-inverted);
    transform: rotate(180deg);
    opacity: 0;
  }

  /* Active states */
  .page-transition.entering .transition-overlay {
    animation: slideIn 500ms var(--ease-dramatic) forwards;
  }

  .page-transition.entering .transition-curve {
    animation: curveIn 500ms var(--ease-dramatic) forwards;
  }

  .page-transition.exiting .transition-overlay {
    animation: slideOut 600ms var(--ease-dramatic) forwards;
  }

  .page-transition.exiting .transition-curve {
    animation: curveOut 600ms var(--ease-dramatic) forwards;
  }

  @keyframes slideIn {
    0% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(0%);
    }
  }

  @keyframes slideOut {
    0% {
      transform: translateY(0%);
    }
    100% {
      transform: translateY(-100%);
    }
  }

  @keyframes curveIn {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes curveOut {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const CURVE_FLAT_BOTTOM = 'M0,100 Q50,100 100,100 L100,100 L0,100 Z';
  const CURVE_ARCH = 'M0,100 Q50,0 100,100 L100,100 L0,100 Z';
  const CURVE_FULL = 'M0,0 Q50,0 100,0 L100,100 L0,100 Z';

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function getEls() {
    const transition = document.getElementById('page-transition');
    const curvePath = transition?.querySelector('.curve-path') ?? null;
    return { transition, curvePath };
  }

  function playCover(): Promise<void> {
    const { transition, curvePath } = getEls();
    if (!transition) return Promise.resolve();

    return new Promise((resolve) => {
      const overlay = transition.querySelector<HTMLElement>('.transition-overlay');
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        resolve();
      };
      overlay?.addEventListener('animationend', finish, { once: true });
      window.setTimeout(finish, 650); // safety net if animationend never fires

      transition.classList.remove('exiting');
      transition.classList.add('entering');
      if (curvePath) {
        gsap.timeline()
          .set(curvePath, { attr: { d: CURVE_FLAT_BOTTOM } })
          .to(curvePath, { attr: { d: CURVE_ARCH }, duration: 0.25, ease: 'power2.in' })
          .to(curvePath, { attr: { d: CURVE_FULL }, duration: 0.25, ease: 'power2.out' });
      }
    });
  }

  function playUncover() {
    const { transition, curvePath } = getEls();
    if (!transition || !transition.classList.contains('entering')) return;

    transition.classList.remove('entering');
    transition.classList.add('exiting');
    if (curvePath) {
      gsap.timeline()
        .to(curvePath, { attr: { d: CURVE_ARCH }, duration: 0.3, ease: 'power2.in' })
        .to(curvePath, { attr: { d: CURVE_FULL }, duration: 0.3, ease: 'power2.out' });
    }

    window.setTimeout(() => {
      transition.classList.remove('exiting');
      if (curvePath) gsap.set(curvePath, { attr: { d: CURVE_FLAT_BOTTOM } });
    }, 650);
  }

  document.addEventListener('astro:before-preparation', (event) => {
    if (prefersReducedMotion()) return;

    const loaderEvent = event as Event & { loader: () => Promise<void> };
    const originalLoader = loaderEvent.loader;
    loaderEvent.loader = async () => {
      await Promise.all([originalLoader(), playCover()]);
    };
  });

  document.addEventListener('astro:after-swap', playUncover);
</script>
