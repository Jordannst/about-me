---
// Back to Top Button
// Uses page transition overlay for smooth experience
---

<button 
  id="back-to-top" 
  class="fixed bottom-8 right-8 z-50 w-12 h-12 bg-[var(--bg-inverted)] text-[var(--text-inverted)] opacity-0 pointer-events-none translate-y-4 transition-all duration-500 hover:bg-[var(--accent)] hover:text-[var(--text-inverted)] group"
  aria-label="Back to top"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto transition-transform duration-300 group-hover:-translate-y-1">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<!-- Dedicated overlay for back to top -->
<div id="back-to-top-overlay" class="btt-overlay">
  <div class="btt-overlay-inner"></div>
</div>

<style>
  #back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  
  .btt-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    overflow: hidden;
  }
  
  .btt-overlay-inner {
    position: absolute;
    inset: 0;
    background-color: var(--bg-inverted);
    transform: translateY(100%);
    transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  
  .btt-overlay.entering .btt-overlay-inner {
    transform: translateY(0);
  }
  
  .btt-overlay.exiting .btt-overlay-inner {
    transform: translateY(-100%);
  }
  
  /* No transition when resetting to prevent sliding back */
  .btt-overlay.reset .btt-overlay-inner {
    transition: none;
    transform: translateY(100%);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const backToTop = document.getElementById('back-to-top');
    const overlay = document.getElementById('back-to-top-overlay');
    
    // Show/hide based on scroll position
    const toggleVisibility = () => {
      if (window.scrollY > 500) {
        backToTop?.classList.add('visible');
      } else {
        backToTop?.classList.remove('visible');
      }
    };
    
    // Page transition to top
    backToTop?.addEventListener('click', () => {
      if (overlay) {
        // Step 1: Overlay enters from bottom
        overlay.classList.remove('reset');
        overlay.classList.add('entering');
        
        // Step 2: After fully covered, reload page so all animations reset
        setTimeout(() => {
          window.scrollTo({ top: 0, behavior: 'instant' });
          window.location.href = window.location.pathname;
        }, 500);
      } else {
        // Fallback
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
    
    // Listen to scroll
    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();
  });
</script>
