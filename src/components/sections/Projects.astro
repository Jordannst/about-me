---
import { projects } from '../../data/portfolio';
import SectionLabel from '../SectionLabel.astro';

const featuredProjects = projects.filter(p => p.featured);
---

<section id="work" class="relative py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)]">
  <div class="max-w-[1600px] mx-auto">

    <SectionLabel number="03" label="Selected Work" class="mb-16" />

    <!-- Title block -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16 md:mb-20">
      <h2 class="text-5xl md:text-7xl lg:text-8xl leading-[0.9] text-[var(--text-primary)] reveal-fade-up">
        Featured<br/>
        <em class="not-italic text-[var(--accent-text)] font-light">Projects.</em>
      </h2>
      <p class="hidden md:block text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] max-w-[180px] leading-relaxed reveal-fade-up" style="transition-delay:100ms">
        Move your cursor over each project
      </p>
    </div>

    <!-- Project List -->
    <div
      id="project-list"
      class="relative"
      data-projects={JSON.stringify(featuredProjects.map(p => ({
        title: p.title, image: p.image, year: p.year ?? '', role: p.role ?? '', id: p.id, tags: p.tags.slice(0,3)
      })))}
    >
      {featuredProjects.map((project, index) => (
        <a
          href={`/projects/${project.id}`}
          class="project-row group flex items-center justify-between py-7 md:py-10 border-t border-[var(--border-color)] relative overflow-hidden md:cursor-none transition-all duration-500"
          data-index={index}
        >
          <!-- Row left: number + title -->
          <div class="flex items-center gap-4 md:gap-10 min-w-0 flex-1">
            <span class="row-num shrink-0 text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] transition-colors duration-500">
              0{index + 1}
            </span>
            <div class="min-w-0">
              <h3
                class="row-title text-xl md:text-4xl lg:text-5xl text-[var(--text-primary)] leading-tight transition-all duration-500 truncate"
                data-text={project.title}
              >
                {project.title}
              </h3>
              <!-- Mobile-only: tags row below title -->
              <div class="flex md:hidden gap-2 mt-1.5 flex-wrap">
                {project.tags.slice(0,2).map(tag => (
                  <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--accent-text)] border border-[var(--accent)]/30 px-1.5 py-0.5">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- Row right: tags (desktop hover) + year + thumbnail (mobile) + arrow -->
          <div class="shrink-0 flex items-center gap-3 md:gap-6 ml-3 md:ml-4">
            <!-- Desktop-only tags: revealed on hover AND keyboard focus -->
            <div class="hidden md:flex gap-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300">
              {project.tags.slice(0,2).map(tag => (
                <span class="text-[9px] uppercase tracking-[0.2em] text-[var(--accent-text)] border border-[var(--accent)]/30 px-2 py-1">{tag}</span>
              ))}
            </div>
            <!-- Year: always visible on mobile, hover/focus-only on desktop -->
            <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)] md:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-400">{project.year}</span>
            <!-- Mobile thumbnail -->
            {project.image && (
              <div class="md:hidden shrink-0 w-14 h-14 overflow-hidden bg-[var(--bg-secondary)]">
                <img src={project.image} alt={project.title} width={project.imageWidth} height={project.imageHeight} loading="lazy" class="w-full h-full object-cover" />
              </div>
            )}
            <!-- Arrow: always visible on mobile, hover/focus-only on desktop -->
            <div class="row-arrow w-8 h-8 md:w-9 md:h-9 border border-[var(--accent)] text-[var(--accent-text)] md:border-[var(--border-color)] md:text-[var(--text-primary)] flex items-center justify-center md:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 group-hover:border-[var(--accent)] group-focus-within:border-[var(--accent)] group-hover:text-[var(--accent-text)] group-focus-within:text-[var(--accent-text)] transition-opacity duration-300">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>

          <!-- Hover line sweep — scaleX instead of width so it never triggers layout -->
          <div class="row-line absolute bottom-0 left-0 h-px w-full bg-[var(--accent)] scale-x-0 origin-left group-hover:scale-x-100 group-focus-within:scale-x-100 transition-transform duration-700 ease-[var(--ease-out-expo)]"></div>
        </a>
      ))}

      <!-- Bottom border -->
      <div class="border-t border-[var(--border-color)]"></div>

      <!-- Floating cursor image -->
      <div
        id="float-img-container"
        class="fixed top-0 left-0 pointer-events-none z-[60] opacity-0 transition-opacity duration-400"
        style="will-change: transform;"
      >
        <div id="float-img-inner" class="relative w-[380px] md:w-[480px] aspect-[3/2] overflow-hidden shadow-2xl bg-[var(--bg-secondary)]">
          {featuredProjects.map((project, index) => (
            <img
              src={project.image}
              alt={project.title}
              width={project.imageWidth}
              height={project.imageHeight}
              class="float-img-layer absolute inset-0 w-full h-full object-contain transition-opacity duration-500"
              style={index === 0 ? "opacity:1" : "opacity:0"}
              data-layer={index}
              loading="lazy"
              decoding="async"
            />
          ))}
          <!-- Subtle overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          <!-- Image label -->
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <span id="float-label" class="text-[9px] uppercase tracking-[0.3em] text-white/70"></span>
            <span id="float-year" class="text-[9px] uppercase tracking-[0.3em] text-[var(--accent)]"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- View all -->
    <div class="mt-14 reveal-fade">
      <a href="/projects" class="inline-flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] hover:text-[var(--accent-text)] transition-colors duration-300 group">
        <span>All Projects</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* Dim non-hovered rows when one is active */
  #project-list.has-hover .project-row:not(.is-hovered) {
    opacity: 0.25;
  }

  #project-list.has-hover .project-row.is-hovered .row-title {
    color: var(--accent-text);
  }

  #project-list.has-hover .project-row.is-hovered .row-num {
    color: var(--accent-text);
  }

  /* Keyboard focus: same affordance the mouse gets */
  .project-row:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 4px;
  }

  /* Hide floating image on touch devices */
  @media (hover: none) {
    #float-img-container {
      display: none !important;
    }
  }
</style>

<script>
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&';

  function initProjectPreview() {
    (window as any).__projectPreviewCleanup?.();

    const list = document.getElementById('project-list');
    const rows = document.querySelectorAll<HTMLElement>('.project-row');
    const floatContainer = document.getElementById('float-img-container');
    const floatInner = document.getElementById('float-img-inner');
    const floatLayers = document.querySelectorAll<HTMLElement>('.float-img-layer');
    const floatLabel = document.getElementById('float-label');
    const floatYear = document.getElementById('float-year');
    const canHoverPreview = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (!list || !rows.length || !floatContainer || !floatInner || !canHoverPreview) return;

    const controller = new AbortController();
    const data: { title: string; image: string; year: string; role: string; id: number; tags: string[] }[] =
      JSON.parse(list.dataset.projects ?? '[]');

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rawMouseX = 0;
    let rawMouseY = 0;
    let rafId = 0;
    let activeIndex = -1;
    let scrambleTimer: ReturnType<typeof setInterval> | null = null;

    const GAP = 24;

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function getPreviewSize() {
      const rect = floatInner.getBoundingClientRect();
      return {
        width: rect.width || 480,
        height: rect.height || 320,
      };
    }

    function computeTarget(mx: number, my: number) {
      const { width, height } = getPreviewSize();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const x = mx + GAP + width > vw ? mx - width - GAP : mx + GAP;
      const y = my - height / 2 < 0
        ? GAP
        : my + height / 2 > vh
          ? vh - height - GAP
          : my - height / 2;
      return { x, y };
    }

    function updateTarget() {
      const { x, y } = computeTarget(rawMouseX, rawMouseY);
      targetX = x;
      targetY = y;
    }

    function tick() {
      currentX = lerp(currentX, targetX, 0.1);
      currentY = lerp(currentY, targetY, 0.1);
      floatContainer.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      rafId = requestAnimationFrame(tick);
    }

    function startTracking() {
      if (rafId) return;
      updateTarget();
      currentX = targetX;
      currentY = targetY;
      floatContainer.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      rafId = requestAnimationFrame(tick);
    }

    function stopTracking() {
      if (!rafId) return;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    document.addEventListener(
      'mousemove',
      (e: MouseEvent) => {
        rawMouseX = e.clientX;
        rawMouseY = e.clientY;
        updateTarget();
      },
      { signal: controller.signal },
    );

    window.addEventListener('resize', updateTarget, { signal: controller.signal });

    function scramble(el: HTMLElement, originalText: string, duration = 600) {
      let frame = 0;
      const totalFrames = Math.floor(duration / 40);
      const interval = setInterval(() => {
        const progress = frame / totalFrames;
        el.textContent = originalText
          .split('')
          .map((char, i) => {
            if (char === ' ') return ' ';
            if (i < Math.floor(progress * originalText.length)) return char;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          })
          .join('');
        frame++;
        if (frame > totalFrames) {
          clearInterval(interval);
          el.textContent = originalText;
        }
      }, 40);
      return interval;
    }

    function showProject(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;
      const project = data[index];
      if (!project) return;

      floatContainer.style.opacity = '1';
      if (floatLabel) floatLabel.textContent = project.role;
      if (floatYear) floatYear.textContent = project.year;

      floatLayers.forEach((layer, i) => {
        layer.style.opacity = i === index ? '1' : '0';
      });

      list.classList.add('has-hover');
      rows.forEach((row, i) => {
        row.classList.toggle('is-hovered', i === index);
      });

      const titleEl = rows[index]?.querySelector<HTMLElement>('.row-title');
      const originalText = project.title;
      if (titleEl) {
        if (scrambleTimer) clearInterval(scrambleTimer);
        scrambleTimer = scramble(titleEl, originalText, 500);
      }

      startTracking();
    }

    function hideProject() {
      activeIndex = -1;
      floatContainer.style.opacity = '0';
      list.classList.remove('has-hover');
      rows.forEach(row => row.classList.remove('is-hovered'));
      if (scrambleTimer) {
        clearInterval(scrambleTimer);
        scrambleTimer = null;
      }
      rows.forEach((row, i) => {
        const titleEl = row.querySelector<HTMLElement>('.row-title');
        if (titleEl && data[i]) titleEl.textContent = data[i].title;
      });
      stopTracking();
    }

    rows.forEach((row) => {
      const index = parseInt(row.dataset.index ?? '0', 10);
      row.addEventListener('mouseenter', () => showProject(index), { signal: controller.signal });
      row.addEventListener('mouseleave', hideProject, { signal: controller.signal });
    });

    list.addEventListener('mouseleave', hideProject, { signal: controller.signal });

    const cleanup = () => {
      hideProject();
      controller.abort();
      stopTracking();
      (window as any).__projectPreviewCleanup = null;
    };

    (window as any).__projectPreviewCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true, signal: controller.signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectPreview, { once: true });
  } else {
    initProjectPreview();
  }

  if (!(window as any).__projectPreviewAfterSwapBound) {
    document.addEventListener('astro:after-swap', initProjectPreview);
    (window as any).__projectPreviewAfterSwapBound = true;
  }
</script>
