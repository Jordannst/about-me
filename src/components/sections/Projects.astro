---
import { projects } from '../../data/portfolio';

const featuredProjects = projects.filter(p => p.featured);
---

<section id="work" class="relative py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)]">
  <div class="max-w-[1600px] mx-auto">

    <!-- Section Label -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">02</span>
      <div class="h-px w-8 bg-[var(--border-color)]"></div>
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">Selected Work</span>
    </div>

    <!-- Title block -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16 md:mb-20">
      <h2 class="text-5xl md:text-7xl lg:text-8xl leading-[0.9] text-[var(--text-primary)] reveal-fade-up">
        Featured<br/>
        <em class="not-italic text-[var(--accent)] font-light">Projects.</em>
      </h2>
      <p class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] max-w-[180px] leading-relaxed reveal-fade-up" style="transition-delay:100ms">
        Move your cursor over each project
      </p>
    </div>

    <!-- Project List -->
    <div
      id="project-list"
      class="relative"
      data-projects={JSON.stringify(featuredProjects.map(p => ({
        title: p.title, image: p.image, year: p.year ?? '', role: p.role ?? '', id: p.id, tags: p.tags.slice(0,3)
      })))}
    >
      {featuredProjects.map((project, index) => (
        <a
          href={`/projects/${project.id}`}
          class="project-row group flex items-center justify-between py-8 md:py-10 border-t border-[var(--border-color)] relative overflow-hidden cursor-none transition-all duration-500"
          data-index={index}
        >
          <!-- Row left: number + title -->
          <div class="flex items-center gap-6 md:gap-10 min-w-0">
            <span class="row-num shrink-0 text-[11px] uppercase tracking-[0.3em] text-[var(--text-secondary)] transition-all duration-500">
              0{index + 1}
            </span>
            <h3
              class="row-title text-2xl md:text-4xl lg:text-5xl text-[var(--text-primary)] leading-tight transition-all duration-500 truncate"
              data-text={project.title}
            >
              {project.title}
            </h3>
          </div>

          <!-- Row right: tags + year + arrow -->
          <div class="shrink-0 flex items-center gap-6 ml-4">
            <div class="hidden md:flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              {project.tags.slice(0,2).map(tag => (
                <span class="text-[9px] uppercase tracking-[0.2em] text-[var(--accent)] border border-[var(--accent)]/30 px-2 py-1">{tag}</span>
              ))}
            </div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)] opacity-0 group-hover:opacity-100 transition-opacity duration-400">{project.year}</span>
            <div class="row-arrow w-9 h-9 border border-[var(--border-color)] flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all duration-300">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>

          <!-- Hover line sweep -->
          <div class="row-line absolute bottom-0 left-0 h-px w-0 bg-[var(--accent)] group-hover:w-full transition-all duration-700 ease-out"></div>
        </a>
      ))}

      <!-- Bottom border -->
      <div class="border-t border-[var(--border-color)]"></div>

      <!-- Floating cursor image -->
      <div
        id="float-img-container"
        class="fixed top-0 left-0 pointer-events-none z-[60] opacity-0 transition-opacity duration-400"
        style="will-change: transform;"
      >
        <div id="float-img-inner" class="relative w-[380px] md:w-[480px] aspect-[3/2] overflow-hidden shadow-2xl bg-[var(--bg-secondary)]">
          {featuredProjects.map((project, index) => (
            <img
              src={project.image}
              alt={project.title}
              class="float-img-layer absolute inset-0 w-full h-full object-contain transition-opacity duration-500"
              style={index === 0 ? "opacity:1" : "opacity:0"}
              data-layer={index}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))}
          <!-- Subtle overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          <!-- Image label -->
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <span id="float-label" class="text-[9px] uppercase tracking-[0.3em] text-white/70"></span>
            <span id="float-year" class="text-[9px] uppercase tracking-[0.3em] text-[var(--accent)]"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- View all -->
    <div class="mt-14 reveal-fade">
      <a href="/projects" class="inline-flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-300 group">
        <span>All Projects</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* Dim non-hovered rows when one is active */
  #project-list.has-hover .project-row:not(.is-hovered) {
    opacity: 0.25;
  }

  #project-list.has-hover .project-row.is-hovered .row-title {
    color: var(--accent);
  }

  #project-list.has-hover .project-row.is-hovered .row-num {
    color: var(--accent);
  }
</style>

<script>
  const list = document.getElementById('project-list');
  const rows = document.querySelectorAll<HTMLElement>('.project-row');
  const floatContainer = document.getElementById('float-img-container');
  const floatLayers = document.querySelectorAll<HTMLElement>('.float-img-layer');
  const floatLabel = document.getElementById('float-label');
  const floatYear = document.getElementById('float-year');

  const data: { title: string; image: string; year: string; role: string; id: number; tags: string[] }[] =
    JSON.parse(list?.dataset.projects ?? '[]');

  // --- Cursor tracking with lerp ---
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let rawMouseX = 0, rawMouseY = 0;
  let rafId: number;

  const IMG_W = 480;
  const IMG_H = Math.round(IMG_W * (2 / 3));
  const GAP = 24;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function computeTarget(mx: number, my: number) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Flip horizontal if too close to right edge
    const x = mx + GAP + IMG_W > vw ? mx - IMG_W - GAP : mx + GAP;
    // Flip vertical if too close to bottom edge
    const y = my - IMG_H / 2 < 0
      ? GAP
      : my + IMG_H / 2 > vh
        ? vh - IMG_H - GAP
        : my - IMG_H / 2;
    return { x, y };
  }

  function tick() {
    currentX = lerp(currentX, targetX, 0.1);
    currentY = lerp(currentY, targetY, 0.1);
    if (floatContainer) {
      floatContainer.style.transform = `translate(${currentX}px, ${currentY}px)`;
    }
    rafId = requestAnimationFrame(tick);
  }
  tick();

  document.addEventListener('mousemove', (e: MouseEvent) => {
    rawMouseX = e.clientX;
    rawMouseY = e.clientY;
    const { x, y } = computeTarget(rawMouseX, rawMouseY);
    targetX = x;
    targetY = y;
  });

  // --- Text scramble ---
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&';
  function scramble(el: HTMLElement, originalText: string, duration = 600) {
    let frame = 0;
    const totalFrames = Math.floor(duration / 40);
    const interval = setInterval(() => {
      const progress = frame / totalFrames;
      el.textContent = originalText
        .split('')
        .map((char, i) => {
          if (char === ' ') return ' ';
          if (i < Math.floor(progress * originalText.length)) return char;
          return CHARS[Math.floor(Math.random() * CHARS.length)];
        })
        .join('');
      frame++;
      if (frame > totalFrames) {
        clearInterval(interval);
        el.textContent = originalText;
      }
    }, 40);
    return interval;
  }

  // --- Row hover ---
  let activeIndex = -1;
  let scrambleTimer: ReturnType<typeof setInterval> | null = null;

  function showProject(index: number) {
    if (index === activeIndex) return;
    activeIndex = index;
    const project = data[index];

    // Show container
    if (floatContainer) floatContainer.style.opacity = '1';
    if (floatLabel) floatLabel.textContent = project.role;
    if (floatYear) floatYear.textContent = project.year;

    // Swap image
    floatLayers.forEach((layer, i) => {
      layer.style.opacity = i === index ? '1' : '0';
    });

    // Dim others, highlight active
    list?.classList.add('has-hover');
    rows.forEach((row, i) => {
      row.classList.toggle('is-hovered', i === index);
    });

    // Scramble title
    const titleEl = rows[index]?.querySelector<HTMLElement>('.row-title');
    const originalText = project.title;
    if (titleEl) {
      if (scrambleTimer) clearInterval(scrambleTimer);
      scrambleTimer = scramble(titleEl, originalText, 500);
    }
  }

  function hideProject() {
    activeIndex = -1;
    if (floatContainer) floatContainer.style.opacity = '0';
    list?.classList.remove('has-hover');
    rows.forEach(row => row.classList.remove('is-hovered'));
    if (scrambleTimer) { clearInterval(scrambleTimer); scrambleTimer = null; }
    // Restore all titles
    rows.forEach((row, i) => {
      const titleEl = row.querySelector<HTMLElement>('.row-title');
      if (titleEl && data[i]) titleEl.textContent = data[i].title;
    });
  }

  rows.forEach((row) => {
    const index = parseInt(row.dataset.index ?? '0', 10);
    row.addEventListener('mouseenter', () => showProject(index));
    row.addEventListener('mouseleave', hideProject);
  });
</script>
