---
import { personal, social } from '../../data/portfolio';
import MagneticButton from '../MagneticButton.astro';
import SectionLabel from '../SectionLabel.astro';
import TextReveal from '../TextReveal.astro';
---

<section id="contact" class="py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)]">
  <div class="max-w-[1600px] mx-auto">
    <SectionLabel number="06" label="Contact" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column -->
      <div class="lg:col-span-5 reveal-fade-up">
        <TextReveal tag="h2" animation="words" stagger={0.1} class="text-4xl md:text-5xl lg:text-7xl leading-[0.95] mb-8 text-[var(--text-primary)]">
          Let's work
          <br />
          <span class="italic text-[var(--accent-text)]">together</span>
        </TextReveal>
        
        <p class="text-lg text-[var(--text-secondary)] max-w-md leading-relaxed mb-12">
          Have a project in mind or just want to chat? I'd love to hear from you.
        </p>

        <!-- Direct Contact Info -->
        <div class="space-y-8">
          <!-- Email -->
          <div class="border-t border-[var(--border-strong)] pt-6">
            <span class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] block mb-3">
              Email
            </span>
            <MagneticButton strength={0.3}>
              <a 
                href={`mailto:${personal.email}`}
                class="font-[family-name:var(--font-serif)] text-xl md:text-2xl text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors duration-500 inline-block"
              >
                {personal.email}
              </a>
            </MagneticButton>
          </div>

          <!-- Social Links -->
          <div class="border-t border-[var(--border-strong)] pt-6">
            <span class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] block mb-4">
              Social
            </span>
            <div class="flex flex-wrap gap-6">
              <MagneticButton strength={0.4}>
                <a 
                  href={social.github}
                  target="_blank"
                  rel="noopener"
                  class="text-sm uppercase tracking-[0.2em] text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors duration-500 link-underline"
                >
                  GitHub
                </a>
              </MagneticButton>
              <MagneticButton strength={0.4}>
                <a 
                  href={social.linkedin}
                  target="_blank"
                  rel="noopener"
                  class="text-sm uppercase tracking-[0.2em] text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors duration-500 link-underline"
                >
                  LinkedIn
                </a>
              </MagneticButton>
              <MagneticButton strength={0.4}>
                <a 
                  href={social.instagram}
                  target="_blank"
                  rel="noopener"
                  class="text-sm uppercase tracking-[0.2em] text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors duration-500 link-underline"
                >
                  Instagram
                </a>
              </MagneticButton>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="lg:col-span-6 lg:col-start-7">
        <form id="contact-form" class="space-y-8 reveal-fade-up" style="transition-delay: 200ms;" data-email={personal.email}>
          <!-- Name Field -->
          <div class="form-group relative mt-8">
            <input 
              type="text" 
              id="contact-name"
              name="name"
              required
              autocomplete="name"
              class="contact-input peer w-full bg-transparent border-b border-[var(--border-color)] py-3 text-lg text-[var(--text-primary)] focus:outline-none transition-colors duration-500"
              placeholder=" "
            />
            <label for="contact-name" class="contact-label absolute left-0 text-[var(--text-secondary)] pointer-events-none transition-all duration-300">
              Name
            </label>
          </div>

          <!-- Email Field -->
          <div class="form-group relative mt-8">
            <input 
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              class="contact-input peer w-full bg-transparent border-b border-[var(--border-color)] py-3 text-lg text-[var(--text-primary)] focus:outline-none transition-colors duration-500"
              placeholder=" "
            />
            <label for="contact-email" class="contact-label absolute left-0 text-[var(--text-secondary)] pointer-events-none transition-all duration-300">
              Email
            </label>
          </div>

          <!-- Subject Field -->
          <div class="form-group relative mt-8">
            <input 
              type="text"
              id="contact-subject"
              name="subject"
              required
              class="contact-input peer w-full bg-transparent border-b border-[var(--border-color)] py-3 text-lg text-[var(--text-primary)] focus:outline-none transition-colors duration-500"
              placeholder=" "
            />
            <label for="contact-subject" class="contact-label absolute left-0 text-[var(--text-secondary)] pointer-events-none transition-all duration-300">
              Subject
            </label>
          </div>

          <!-- Message Field -->
          <div class="form-group relative mt-12">
            <textarea 
              id="contact-message"
              name="message"
              required
              rows={4}
              class="contact-input peer w-full bg-transparent border-b border-[var(--border-color)] py-3 text-lg text-[var(--text-primary)] focus:outline-none transition-colors duration-500 resize-none"
              placeholder=" "
            ></textarea>
            <label for="contact-message" class="contact-label absolute left-0 text-[var(--text-secondary)] pointer-events-none transition-all duration-300">
              Message
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <MagneticButton strength={0.3}>
              <button 
                type="submit"
                class="btn-primary px-8 py-4 inline-flex items-center gap-3"
              >
                <span class="text-xs uppercase tracking-[0.2em]">Send Message</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="relative z-1">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </MagneticButton>
          </div>

          <!-- Form Status (role=status so screen readers hear the update) -->
          <div id="form-status" class="hidden" role="status" aria-live="polite">
            <p class="text-sm text-[var(--accent-text)]"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-input {
    font-family: var(--font-sans);
  }

  /* Floating Label Styles */
  .contact-label {
    top: 12px;
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  /* When input is focused OR has content, float the label up */
  .contact-input:focus ~ .contact-label,
  .contact-input:not(:placeholder-shown) ~ .contact-label {
    top: -20px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--accent-text);
  }

  /* Animated focus indicator — scaleX from center, no layout work */
  .form-group::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.6s var(--ease-luxury);
  }

  .form-group:focus-within::after {
    transform: scaleX(1);
  }
</style>

<script>
  // The form hands off to the visitor's mail app (mailto:). There is no
  // backend, so the status copy is honest about that and offers the raw
  // address as a fallback instead of claiming the message was "sent".
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form || !status) return;
    if (form.dataset.contactInitialized === 'true') return;
    form.dataset.contactInitialized = 'true';

    const email = form.dataset.email || '';
    let hideTimer = 0;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const fromEmail = formData.get('email') as string;
      const subject = formData.get('subject') as string;
      const message = formData.get('message') as string;

      const bodyLines = [
        'Hi Jordan,',
        '',
        `My name is ${name}.`,
        `Email: ${fromEmail}`,
        '',
        message,
      ].join('\r\n');
      const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines)}`;

      window.location.href = mailtoUrl;

      status.classList.remove('hidden');
      const statusP = status.querySelector('p');
      if (statusP) {
        statusP.textContent = `Your email app should open with the message pre-filled. If nothing happens, email me directly at ${email}.`;
      }

      if (hideTimer) window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        status.classList.add('hidden');
      }, 8000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
  document.addEventListener('astro:after-swap', initContactForm);
</script>
