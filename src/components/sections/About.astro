---
import { about } from '../../data/portfolio';
import ImageReveal from '../ImageReveal.astro';
import TextReveal from '../TextReveal.astro';
import Typewriter from '../Typewriter.astro';
---

<section id="about" class="py-20 md:py-32 px-8 md:px-16 border-t border-[var(--border-color)]">
  <div class="max-w-[1600px] mx-auto">
    <!-- Section Label -->
    <div class="flex items-center gap-4 mb-12 md:mb-16 reveal">
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
        01
      </span>
      <div class="h-px w-8 bg-[var(--border-color)]"></div>
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
        About
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column: Headline + Photo -->
      <div class="lg:col-span-5 lg:col-start-2">
        <TextReveal tag="h2" animation="words" stagger={0.08} class="text-4xl md:text-5xl lg:text-6xl leading-[0.95] mb-8 text-[var(--text-primary)]">
          Creating
          <br />
          <span class="italic text-[var(--accent)]">Digital</span>
          <br />
          Experiences
        </TextReveal>
        
        <!-- Profile Photo with ImageReveal -->
        <div class="mt-8 lg:mt-12">
          <div class="profile-photo-wrapper aspect-[4/5] w-full max-w-sm relative cursor-pointer">
            <ImageReveal 
              src="/jordan-profile.webp" 
              alt="Jordan Sutarto"
              direction="left"
              class="w-full h-full"
            />
            
            <!-- Decorative corner with glow -->
            <div class="profile-border absolute -bottom-3 -right-3 w-full h-full border border-[var(--accent)] -z-10"></div>
          </div>
        </div>
      </div>

      <!-- Right Column: Bio Text -->
      <div class="lg:col-span-5 lg:col-start-8 lg:pt-32">
        <p class="drop-cap text-lg leading-relaxed text-[var(--text-primary)] mb-6 reveal-fade-up" style="transition-delay: 300ms;">
          {about.intro}
        </p>
        <p class="text-lg leading-relaxed text-[var(--text-secondary)] reveal-fade-up" style="transition-delay: 450ms;">
          {about.highlight}
        </p>
        
        <!-- Quote -->
        <div class="mt-12 pt-8 border-t border-[var(--border-color)]">
          <blockquote class="relative">
            <Typewriter 
              text='"The only way to do great work is to love what you do."' 
              tag="p" 
              speed={35}
              delay={300}
              class="font-[family-name:var(--font-serif)] text-xl md:text-2xl italic text-[var(--text-primary)] leading-relaxed mb-4"
            />
            <br />
            <Typewriter 
              text="— Steve Jobs" 
              tag="cite" 
              speed={50}
              delay={2300}
              hideCursorOnComplete={true}
              class="text-[10px] uppercase tracking-[0.2em] text-[var(--accent)] not-italic"
            />
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-border {
    transition: box-shadow 0.5s ease, transform 0.5s ease;
  }

  /* Hover effect on desktop */
  .profile-photo-wrapper:hover .profile-border {
    box-shadow: 0 0 25px rgba(181, 155, 107, 0.5), 0 0 50px rgba(181, 155, 107, 0.3);
    transform: translate(-2px, -2px);
  }

  /* Always active on touch devices (mobile/tablet) */
  @media (hover: none) and (pointer: coarse) {
    .profile-border {
      box-shadow: 0 0 25px rgba(181, 155, 107, 0.5), 0 0 50px rgba(181, 155, 107, 0.3);
      transform: translate(-2px, -2px);
    }
  }
</style>
