---
// Minimal editorial statement — a quiet breather between About and the work.
// Personal voice, no scroll-jacking. Reuses the site's signature motion:
//   • TextReveal (word slide-up) for the headline — same as About/Hero
//   • BlurText (blur-to-clear) for the supporting line — same as Hero tagline
import TextReveal from '../TextReveal.astro';
import BlurText from '../BlurText.astro';
---

<section
  id="statement"
  class="py-24 md:py-40 px-8 md:px-16 border-t border-[var(--border-color)]"
>
  <div class="max-w-[1600px] mx-auto">
    <!-- Section Label -->
    <div class="flex items-center gap-4 mb-12 md:mb-16 reveal">
      <div class="h-px w-8 bg-[var(--border-color)]"></div>
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
        Statement
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12">
      <div class="lg:col-span-10 lg:col-start-2">
        <TextReveal
          tag="h2"
          animation="words"
          stagger={0.08}
          duration={0.9}
          class="font-[family-name:var(--font-serif)] text-4xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight text-[var(--text-primary)]"
        >
          Still a student,
          <br />
          <span class="italic text-[var(--accent)]">already shipping</span>
          <br />
          real work.
        </TextReveal>

        <BlurText
          tag="p"
          delay={0.5}
          stagger={0.05}
          duration={0.8}
          class="mt-10 md:mt-12 max-w-2xl text-lg md:text-xl leading-relaxed text-[var(--text-secondary)]"
        >
          Each project below began as a real problem worth solving, and a
          reason to learn what no lecture ever could.
        </BlurText>
      </div>
    </div>
  </div>
</section>
