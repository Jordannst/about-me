---
// Statement.astro - Scrollytelling cinematic massive scale text section
---

<section id="statement-scrolly" class="relative h-[300vh] bg-[var(--bg-primary)]">
  <div class="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden">
    
    <!-- Background Blob (retained but subtle) -->
    <div class="statement-blob absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] max-w-[600px] max-h-[600px] rounded-full pointer-events-none opacity-50 mix-blend-screen" style="background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%);"></div>

    <!-- The Text that will be scaled massively -->
    <div class="zoom-text-container absolute inset-0 flex flex-col items-center justify-center font-[family-name:var(--font-serif)] text-[var(--accent)] pointer-events-none z-10 mix-blend-difference">
      <div class="zoom-target text-center">
        <div class="zoom-word text-[12vw] md:text-[8vw] lg:text-[7vw] leading-[0.85] tracking-tight whitespace-nowrap">
          Digital
        </div>
        <div class="zoom-word text-[12vw] md:text-[8vw] lg:text-[7vw] leading-[0.85] tracking-tight whitespace-nowrap italic text-[var(--text-primary)]">
          Experiences
        </div>
      </div>
    </div>

    <!-- Intro Text (fades out as scroll starts) -->
    <div class="intro-text absolute top-[25%] left-1/2 -translate-x-1/2 -translate-y-1/2 text-center w-full px-6">
      <p class="text-xs uppercase tracking-[0.4em] text-[var(--text-secondary)]">I believe in crafting</p>
    </div>

    <!-- Outro Text (fades in when scale is huge) -->
    <div class="outro-text absolute inset-0 flex items-center justify-center opacity-0 z-0 px-6 text-center">
       <p class="font-[family-name:var(--font-serif)] text-2xl md:text-5xl lg:text-6xl text-[var(--text-primary)] leading-[1.2]">
         That are both beautiful<br/>
         <span class="italic text-[var(--accent)]">and purposeful.</span>
       </p>
    </div>

  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../lib/gsap-setup';
  import SplitType from 'split-type';

  function initScrollytelling() {

    const section = document.getElementById('statement-scrolly');
    const zoomTarget = section?.querySelector('.zoom-target');
    const introText = section?.querySelector('.intro-text');
    const outroText = section?.querySelector('.outro-text');
    const words = section?.querySelectorAll('.zoom-word');

    if (!section || !zoomTarget || !words || words.length === 0) return;

    // Prepare Outro Text Staggered Reveal
    let outroSplit: SplitType | null = null;
    let outroWords: HTMLElement[] | null = null;
    if (outroText) {
      const p = outroText.querySelector('p');
      if (p) {
        outroSplit = new SplitType(p as HTMLElement, { types: 'words' });
        if (outroSplit.words) {
          outroWords = outroSplit.words;
          gsap.set(outroWords, { opacity: 0, y: 40 }); // Initial hidden state
        }
      }
    }

    // Create a timeline mapped to the scroll progress of the section
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom bottom",
        scrub: 1, // Smooth scrubbing
      }
    });

    // Animate Introduction fading out
    if (introText) {
      tl.to(introText, {
        opacity: 0,
        y: -50,
        ease: "power2.out",
        duration: 0.1
      }, 0);
    }

    // Phase 1: Mild scale and letter-spacing separation
    tl.to(words, {
      letterSpacing: "0.2em",
      duration: 0.2,
      ease: "power1.inOut"
    }, 0);

    // Phase 2: Massive Scale Up
    // Using a large scale value to fill the screen
    tl.to(zoomTarget, {
      scale: 150,
      opacity: 0, // Fade out the massive text at the very end
      transformOrigin: "center center",
      ease: "power3.in",
      duration: 0.8
    }, 0.1);

    // Phase 3: Fade in the Outro Text inside the "hole" or after fade out
    if (outroText && outroWords) {
      tl.to(outroText, { opacity: 1, duration: 0.01 }, 0.6); // Reveal wrapper instantly
      tl.to(outroWords, {
        opacity: 1,
        y: 0,
        stagger: 0.05,
        duration: 0.4,
        ease: "power3.out"
      }, 0.6); 
    }
  }

  // Initialize on load and after Astro swaps
  document.addEventListener('DOMContentLoaded', initScrollytelling);
  document.addEventListener('astro:after-swap', initScrollytelling);
</script>
