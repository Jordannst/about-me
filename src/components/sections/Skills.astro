// Define skill sizes for 17 items on a 12-column grid
// Layout plan (desktop):
//   Row 1: 3 large (4+4+4 = 12)
//   Row 2: 4 medium (3+3+3+3 = 12)
//   Row 3: 4 medium (3+3+3+3 = 12)
//   Row 4: 6 small (2+2+2+2+2+2 = 12)
const sizeMap: Record<string, string> = {
  // Row 1: Large (first 3)
  'JavaScript': 'large',
  'TypeScript': 'large',
  'Python': 'large',
  // Row 2: Medium
  'Golang': 'medium',
  'PHP': 'medium',
  'React': 'medium',
  'React Native': 'medium',
  // Row 3: Medium
  'Next.js': 'medium',
  'Tailwind CSS': 'medium',
  'Node.js': 'medium',
  'Express.js': 'medium',
  // Row 4: Small
  'Laravel': 'small',
  'MongoDB': 'small',
  'PostgreSQL': 'small',
  'Supabase': 'small',
  'Git': 'small',
  'Figma': 'small',
};

const skillsWithSize = skills.map((skill, index) => {
  return {
    ...skill,
    size: sizeMap[skill.name] || 'small',
    icon: skillIcons[skill.name] || ''
  };
});
---

<!-- Skills section with main theme -->
<section id="skills" class="py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)]">
  <div class="max-w-[1600px] mx-auto">
    <SectionLabel number="04" label="Expertise" />

    <!-- Section Title -->
    <h2 class="text-4xl md:text-5xl lg:text-7xl leading-[0.95] mb-16 md:mb-24 reveal-fade-up">
      Skills &
      <span class="italic text-[var(--accent-text)]">Technologies</span>
    </h2>

    <!-- Staggered Grid -->
    <div class="staggered-grid" id="skills-grid">
      {skillsWithSize.map((skill, index) => (
        <div 
          class={`skill-item skill-${skill.size}`} 
          data-skill-index={index}
        >
          <!-- SpotlightCard overlay -->
          <div class="spotlight-overlay" aria-hidden="true"></div>
          <div class="skill-content">
            <span class="skill-category">{skill.category}</span>
            <span class="skill-name">{skill.name}</span>
          </div>
          {skill.icon && (
            <div class="skill-icon" set:html={skill.icon} />
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .staggered-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    grid-auto-rows: minmax(80px, auto);
  }
  
  .skill-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    background: transparent;
    transition:
      background var(--duration-normal) var(--ease-luxury),
      border-color var(--duration-normal) var(--ease-luxury),
      box-shadow var(--duration-normal) var(--ease-luxury);
    opacity: 0;
    transform: translateY(60px) scale(0.85);
    position: relative;
    overflow: hidden;
  }

  /* SpotlightCard overlay */
  .spotlight-overlay {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s var(--ease-luxury);
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      350px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%),
      rgba(212, 175, 55, 0.12) 0%,
      rgba(212, 175, 55, 0.05) 40%,
      transparent 70%
    );
  }

  :root.dark .spotlight-overlay {
    background: radial-gradient(
      350px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%),
      rgba(212, 175, 55, 0.15) 0%,
      rgba(212, 175, 55, 0.06) 40%,
      transparent 70%
    );
  }

  .skill-item:hover .spotlight-overlay {
    opacity: 1;
  }

  /* Disable spotlight on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .spotlight-overlay {
      display: none;
    }
  }
  
  .skill-content {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }
  
  .skill-item:hover {
    background: var(--bg-secondary);
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--accent) 15%, transparent);
  }
  
  .skill-item:hover .skill-icon {
    opacity: 1;
    color: var(--accent-text);
  }
  
  .skill-category {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-text);
    margin-bottom: 0.5rem;
  }
  
  .skill-name {
    font-family: var(--font-serif);
    color: inherit;
  }
  
  .skill-icon {
    opacity: 0.3;
    transition:
      opacity var(--duration-normal) var(--ease-luxury),
      color var(--duration-normal) var(--ease-luxury);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  
  .skill-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  
  /* Large skills - primary */
  .skill-large {
    grid-column: span 4;
    grid-row: span 2;
    padding: 1.5rem;
  }
  
  .skill-large .skill-name {
    font-size: 2rem;
  }
  
  .skill-large .skill-icon {
    width: 48px;
    height: 48px;
  }
  
  /* Medium skills */
  .skill-medium {
    grid-column: span 3;
    grid-row: span 1;
  }
  
  .skill-medium .skill-name {
    font-size: 1.5rem;
  }
  
  .skill-medium .skill-icon {
    width: 32px;
    height: 32px;
  }
  
  /* Small skills */
  .skill-small {
    grid-column: span 2;
    grid-row: span 1;
  }
  
  .skill-small .skill-name {
    font-size: 1.125rem;
  }
  
  .skill-small .skill-icon {
    width: 24px;
    height: 24px;
  }
  
  /* Mobile responsive */
  @media (max-width: 640px) {
    .staggered-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    
    .skill-large {
      grid-column: span 4;
      grid-row: span 1;
    }
    
    .skill-medium {
      grid-column: span 2;
    }
    
    .skill-small {
      grid-column: span 2;
    }
    
    .skill-large .skill-name,
    .skill-medium .skill-name,
    .skill-small .skill-name {
      font-size: 1rem;
    }
    
    .skill-item {
      min-height: 70px;
    }
    
    .skill-large .skill-icon,
    .skill-medium .skill-icon,
    .skill-small .skill-icon {
      width: 20px;
      height: 20px;
    }
  }

  /* Tablet responsive (641px - 1024px) */
  @media (min-width: 641px) and (max-width: 1024px) {
    .staggered-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 0.75rem;
    }
    
    .skill-large {
      grid-column: span 3;
      grid-row: span 1;
    }
    
    .skill-large .skill-name {
      font-size: 1.25rem;
    }
    
    .skill-large .skill-icon {
      width: 28px;
      height: 28px;
    }
    
    .skill-medium {
      grid-column: span 2;
    }
    
    .skill-medium .skill-name {
      font-size: 1.125rem;
    }
    
    .skill-medium .skill-icon {
      width: 24px;
      height: 24px;
    }
    
    .skill-small {
      grid-column: span 2;
    }
    
    .skill-small .skill-name {
      font-size: 1rem;
    }
    
    .skill-small .skill-icon {
      width: 20px;
      height: 20px;
    }
    
    .skill-item {
      padding: 1rem;
      min-height: auto;
    }
  }
  
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/gsap-setup';


  function initSkillsAnimation() {
    const grid = document.getElementById('skills-grid');
    if (!grid) return;
    if (grid.dataset.skillsAnimationInitialized === 'true') return;

    const items = grid.querySelectorAll('.skill-item');
    if (!items.length) return;

    grid.dataset.skillsAnimationInitialized = 'true';
    ScrollTrigger.getById('skills-grid-reveal')?.kill();
    gsap.killTweensOf(items);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(items, { opacity: 1, y: 0, scale: 1 });
      return;
    }

    // Block stacking animation
    gsap.to(items, {
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 0.7,
      stagger: {
        each: 0.1,
        from: 'start',
      },
      ease: 'back.out(1.2)',
      scrollTrigger: {
        id: 'skills-grid-reveal',
        trigger: grid,
        start: 'top 75%',
        toggleActions: 'play none none none',
      },
    });

    document.addEventListener('astro:before-swap', () => {
      ScrollTrigger.getById('skills-grid-reveal')?.kill();
      gsap.killTweensOf(items);
      delete grid.dataset.skillsAnimationInitialized;
    }, { once: true });
  }

  // SpotlightCard: Mouse tracking for gold spotlight effect
  function initSpotlightCards() {
    const items = document.querySelectorAll('.skill-item');

    // Skip on touch devices
    if (window.matchMedia('(hover: none), (pointer: coarse), (prefers-reduced-motion: reduce)').matches) return;

    items.forEach((item) => {
      const el = item as HTMLElement;
      if (el.dataset.spotlightInitialized === 'true') return;

      const controller = new AbortController();
      let rect: DOMRect | null = null;
      let pointerX = 0;
      let pointerY = 0;
      let rafId = 0;

      const updateSpotlight = () => {
        rafId = 0;
        if (!rect) return;

        el.style.setProperty('--spotlight-x', `${pointerX - rect.left}px`);
        el.style.setProperty('--spotlight-y', `${pointerY - rect.top}px`);
      };

      el.dataset.spotlightInitialized = 'true';

      el.addEventListener('pointerenter', () => {
        rect = el.getBoundingClientRect();
      }, { signal: controller.signal });

      el.addEventListener('pointermove', (e: PointerEvent) => {
        pointerX = e.clientX;
        pointerY = e.clientY;
        if (!rafId) rafId = requestAnimationFrame(updateSpotlight);
      }, { signal: controller.signal });

      el.addEventListener('pointerleave', () => {
        rect = null;
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
      }, { signal: controller.signal });

      document.addEventListener('astro:before-swap', () => {
        controller.abort();
        if (rafId) cancelAnimationFrame(rafId);
        delete el.dataset.spotlightInitialized;
      }, { once: true, signal: controller.signal });
    });
  }

  let skillsAnimationTimeout = 0;

  function initSkillsSection() {
    if (skillsAnimationTimeout) window.clearTimeout(skillsAnimationTimeout);
    skillsAnimationTimeout = window.setTimeout(() => {
      skillsAnimationTimeout = 0;
      initSkillsAnimation();
    }, 200);
    initSpotlightCards();
  }

  function clearSkillsSchedule() {
    if (skillsAnimationTimeout) window.clearTimeout(skillsAnimationTimeout);
    skillsAnimationTimeout = 0;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkillsSection, { once: true });
  } else {
    initSkillsSection();
  }

  if (!(window as any).__skillsAfterSwapBound) {
    document.addEventListener('astro:after-swap', initSkillsSection);
    (window as any).__skillsAfterSwapBound = true;
  }

  if (!(window as any).__skillsBeforeSwapBound) {
    document.addEventListener('astro:before-swap', clearSkillsSchedule);
    (window as any).__skillsBeforeSwapBound = true;
  }
</script>
