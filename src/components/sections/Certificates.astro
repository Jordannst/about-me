---
import { certificates } from '../../data/portfolio';
import TextReveal from '../TextReveal.astro';

const years = certificates.map(c => parseInt(c.date)).filter(n => !isNaN(n) && n > 0);
const yearMin = years.length > 0 ? Math.min(...years) : new Date().getFullYear();
const yearMax = years.length > 0 ? Math.max(...years) : new Date().getFullYear();
const yearRange = yearMin === yearMax ? `${yearMin}` : `${yearMin}–${yearMax}`;

const competitionCount = certificates.filter(c => c.type === 'competition').length;

const placements: Record<string, number> = {
  '1st': 1, 'first': 1,
  '2nd': 2, 'second': 2,
  '3rd': 3, 'third': 3,
  'honorable': 99,
};
function parsePlacement(title: string): number {
  const lower = title.toLowerCase();
  for (const [key, rank] of Object.entries(placements)) {
    if (lower.includes(key)) return rank;
  }
  return 999;
}
const bestPlacement = certificates.length > 0
  ? Math.min(...certificates.map(c => parsePlacement(c.title)))
  : 999;
const bestPlacementLabel = bestPlacement === 1 ? '#1'
  : bestPlacement === 2 ? '#2'
  : bestPlacement === 3 ? '#3'
  : 'Top';
---

<section id="certificates" class="relative py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-primary)]">
  <div class="max-w-[1600px] mx-auto">

    <!-- Section Label -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">04</span>
      <div class="h-px w-8 bg-[var(--border-color)]"></div>
      <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">Achievements</span>
    </div>

    <!-- Section Title -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-16 md:mb-20">
      <TextReveal tag="h2" animation="words" stagger={0.08} class="text-5xl md:text-7xl lg:text-8xl leading-[0.9] text-[var(--text-primary)]">
        Certificates &amp;
        <em class="not-italic text-[var(--accent)] font-light">Awards.</em>
      </TextReveal>
      <p class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)] max-w-[180px] leading-relaxed reveal-fade-up" style="transition-delay:100ms">
        Move your cursor over each achievement
      </p>
    </div>

    <!-- Stats Block -->
    <div class="cert-stats reveal-fade-up mb-16 md:mb-24">
      <div class="stat-item">
        <span class="stat-number">{competitionCount}</span>
        <span class="stat-label">Competition Wins</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">{yearRange}</span>
        <span class="stat-label">Years Active</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">{bestPlacementLabel}</span>
        <span class="stat-label">Best Placement</span>
      </div>
    </div>

    <!-- Certificate List -->
    <div
      id="cert-list"
      class="relative"
      data-certs={JSON.stringify(certificates.map(c => ({
        title: c.title,
        issuer: c.issuer,
        image: c.image ?? '',
        date: c.date,
        type: c.type,
        credentialUrl: c.credentialUrl ?? '',
      })))}
    >
      {certificates.map((cert, index) => (
        <div
          class="cert-row group flex items-center justify-between py-6 md:py-10 border-t border-[var(--border-color)] relative overflow-hidden transition-all duration-500 cursor-none"
          data-index={index}
        >
          <!-- Mobile-only inline thumbnail -->
          {cert.image && (
            <div class="cert-thumb shrink-0 md:hidden w-16 h-16 mr-4 overflow-hidden bg-[var(--bg-secondary)]">
              <img
                src={cert.image}
                alt={cert.title}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
          )}

          <!-- Left: number + title + issuer -->
          <div class="flex items-center gap-4 md:gap-10 min-w-0 flex-1">
            <span class="cert-num shrink-0 text-[11px] uppercase tracking-[0.3em] text-[var(--text-secondary)] transition-all duration-500 hidden md:inline">
              0{index + 1}
            </span>
            <div class="min-w-0">
              <h3
                class="cert-title text-xl md:text-4xl lg:text-5xl text-[var(--text-primary)] leading-tight transition-all duration-500 truncate"
                data-text={cert.title}
              >
                {cert.title}
              </h3>
              <p class="cert-issuer text-[10px] uppercase tracking-[0.15em] text-[var(--text-secondary)] mt-1 opacity-60 group-hover:opacity-100 transition-opacity duration-300 truncate">
                {cert.issuer}
              </p>
            </div>
          </div>

          <!-- Right: type + year + arrow -->
          <div class="shrink-0 flex items-center gap-3 md:gap-6 ml-3 md:ml-4">
            <span class="hidden md:inline text-[9px] uppercase tracking-[0.2em] text-[var(--accent)] border border-[var(--accent)]/30 px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              {cert.type}
            </span>
            <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              {cert.date}
            </span>
            {cert.credentialUrl && cert.credentialUrl !== '#' ? (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener"
                class="cert-arrow w-8 h-8 md:w-9 md:h-9 border border-[var(--accent)] text-[var(--accent)] flex items-center justify-center md:opacity-0 md:border-[var(--border-color)] md:text-[var(--text-primary)] group-hover:opacity-100 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all duration-300"
                onclick="event.stopPropagation()"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            ) : (
              <div class="cert-arrow w-8 h-8 md:w-9 md:h-9 border border-[var(--border-color)] flex items-center justify-center opacity-0 md:opacity-0 group-hover:opacity-100 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all duration-300">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 5l7 7-7 7M5 12h14"/>
                </svg>
              </div>
            )}
          </div>

          <!-- Hover line sweep -->
          <div class="absolute bottom-0 left-0 h-px w-0 bg-[var(--accent)] group-hover:w-full transition-all duration-700 ease-out"></div>
        </div>
      ))}

      <!-- "More on the way" row -->
      <div class="cert-row cert-row--more flex items-center justify-between py-8 md:py-10 border-t border-[var(--border-color)] relative opacity-30 transition-all duration-500">
        <div class="flex items-center gap-6 md:gap-10 min-w-0">
          <span class="shrink-0 text-[11px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">—</span>
          <span class="text-2xl md:text-4xl lg:text-5xl text-[var(--text-primary)] leading-tight italic font-light">
            More on the way
          </span>
        </div>
        <span class="shrink-0 text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)] ml-4">Soon</span>
      </div>

      <!-- Bottom border -->
      <div class="border-t border-[var(--border-color)]"></div>

      <!-- Floating cursor image -->
      <div
        id="cert-float-container"
        class="fixed top-0 left-0 pointer-events-none z-[60] opacity-0 transition-opacity duration-400"
        style="will-change: transform;"
      >
        <div id="cert-float-inner" class="relative w-[320px] md:w-[440px] aspect-[4/3] overflow-hidden shadow-2xl bg-[var(--bg-secondary)]">
          {certificates.map((cert, index) => (
            <img
              src={cert.image ?? ''}
              alt={cert.title}
              class="cert-float-layer absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
              style={index === 0 ? "opacity:1" : "opacity:0"}
              data-layer={index}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <span id="cert-float-label" class="text-[9px] uppercase tracking-[0.3em] text-white/70"></span>
            <span id="cert-float-year" class="text-[9px] uppercase tracking-[0.3em] text-[var(--accent)]"></span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Stats block */
  .cert-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  /* Dim non-hovered rows when one is active */
  #cert-list.has-hover .cert-row:not(.is-hovered):not(.cert-row--more) {
    opacity: 0.25;
  }

  #cert-list.has-hover .cert-row.is-hovered .cert-title {
    color: var(--accent);
  }

  #cert-list.has-hover .cert-row.is-hovered .cert-num {
    color: var(--accent);
  }

  /* Hide floating image on touch/mobile */
  @media (hover: none) {
    #cert-float-container {
      display: none !important;
    }
  }
</style>

<script>
  const certList = document.getElementById('cert-list');
  const certRows = document.querySelectorAll<HTMLElement>('.cert-row:not(.cert-row--more)');
  const certFloatContainer = document.getElementById('cert-float-container');
  const certFloatLayers = document.querySelectorAll<HTMLElement>('.cert-float-layer');
  const certFloatLabel = document.getElementById('cert-float-label');
  const certFloatYear = document.getElementById('cert-float-year');

  const certData: { title: string; issuer: string; image: string; date: string; type: string; credentialUrl: string }[] =
    JSON.parse(certList?.dataset.certs ?? '[]');

  // --- Cursor tracking with lerp ---
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let rafId: number;

  const IMG_W = 440;
  const IMG_H = Math.round(IMG_W * (3 / 4));
  const GAP = 24;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function computeCertTarget(mx: number, my: number) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const x = mx + GAP + IMG_W > vw ? mx - IMG_W - GAP : mx + GAP;
    const y = my - IMG_H / 2 < 0
      ? GAP
      : my + IMG_H / 2 > vh
        ? vh - IMG_H - GAP
        : my - IMG_H / 2;
    return { x, y };
  }

  function certTick() {
    currentX = lerp(currentX, targetX, 0.1);
    currentY = lerp(currentY, targetY, 0.1);
    if (certFloatContainer) {
      certFloatContainer.style.transform = `translate(${currentX}px, ${currentY}px)`;
    }
    rafId = requestAnimationFrame(certTick);
  }
  certTick();

  document.addEventListener('mousemove', (e: MouseEvent) => {
    const { x, y } = computeCertTarget(e.clientX, e.clientY);
    targetX = x;
    targetY = y;
  });

  // --- Text scramble ---
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&';
  function scramble(el: HTMLElement, originalText: string, duration = 500) {
    let frame = 0;
    const totalFrames = Math.floor(duration / 40);
    const interval = setInterval(() => {
      const progress = frame / totalFrames;
      el.textContent = originalText
        .split('')
        .map((char, i) => {
          if (char === ' ') return ' ';
          if (i < Math.floor(progress * originalText.length)) return char;
          return CHARS[Math.floor(Math.random() * CHARS.length)];
        })
        .join('');
      frame++;
      if (frame > totalFrames) {
        clearInterval(interval);
        el.textContent = originalText;
      }
    }, 40);
    return interval;
  }

  // --- Row hover ---
  let activeIndex = -1;
  let scrambleTimer: ReturnType<typeof setInterval> | null = null;

  function showCert(index: number) {
    if (index === activeIndex) return;
    activeIndex = index;
    const cert = certData[index];

    if (certFloatContainer) certFloatContainer.style.opacity = '1';
    if (certFloatLabel) certFloatLabel.textContent = cert.type;
    if (certFloatYear) certFloatYear.textContent = cert.date;

    certFloatLayers.forEach((layer, i) => {
      layer.style.opacity = i === index ? '1' : '0';
    });

    certList?.classList.add('has-hover');
    certRows.forEach((row, i) => {
      row.classList.toggle('is-hovered', i === index);
    });

    const titleEl = certRows[index]?.querySelector<HTMLElement>('.cert-title');
    const originalText = cert.title;
    if (titleEl) {
      if (scrambleTimer) clearInterval(scrambleTimer);
      scrambleTimer = scramble(titleEl, originalText, 500);
    }
  }

  function hideCert() {
    activeIndex = -1;
    if (certFloatContainer) certFloatContainer.style.opacity = '0';
    certList?.classList.remove('has-hover');
    certRows.forEach(row => row.classList.remove('is-hovered'));
    if (scrambleTimer) { clearInterval(scrambleTimer); scrambleTimer = null; }
    certRows.forEach((row, i) => {
      const titleEl = row.querySelector<HTMLElement>('.cert-title');
      if (titleEl && certData[i]) titleEl.textContent = certData[i].title;
    });
  }

  certRows.forEach((row) => {
    const index = parseInt(row.dataset.index ?? '0', 10);
    row.addEventListener('mouseenter', () => showCert(index));
    row.addEventListener('mouseleave', hideCert);
  });
</script>
