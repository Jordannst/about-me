---
// Certificates.astro — "Featured + Ledger" (minimal)
//
// One achievement gets the spotlight: the highest-weight entry, picked
// automatically from the data (1st > 2nd > 3rd > honorable > course), so a
// bigger future win takes over without any redesign. Every other entry is a
// thin ledger row. Rows open the credential link when one exists, otherwise
// a minimal lightbox with the certificate image.
import { certificates } from '../../data/portfolio';
import ImageReveal from '../ImageReveal.astro';
import SectionLabel from '../SectionLabel.astro';
import TextReveal from '../TextReveal.astro';

const typeLabels: Record<string, string> = {
  organization: 'Organization',
  competition: 'Competition',
  course: 'Certification',
};

interface ParsedTitle {
  category: string;   // e.g. "UI/UX Design"
  rank: string;       // e.g. "1"
  rankSuffix: string; // e.g. "st"
  rankPhrase: string; // e.g. "Place" / "Honorable Mention"
}

function parseTitle(title: string): ParsedTitle {
  // Matches "<category> <ordinal> <suffix> <phrase?>"
  const m = title.match(/^(.*?)\s+(\d+)(st|nd|rd|th)\s*(.*?)$/i);
  if (!m) return { category: title, rank: '', rankSuffix: '', rankPhrase: '' };
  return {
    category: m[1].trim(),
    rank: m[2],
    rankSuffix: m[3].toLowerCase(),
    rankPhrase: (m[4] || '').trim(),
  };
}

function shortIssuer(issuer: string): string {
  return issuer.split(/[-–—]/)[0].trim();
}

function issuerRest(issuer: string): string {
  return issuer.split(/[-–—]/).slice(1).join(' · ').trim();
}

function brandName(issuer: string): string {
  return shortIssuer(issuer).split(/\s+/)[0];
}

function rankLabel(p: ParsedTitle): string {
  if (!p.rank) return '';
  return `${p.rank}${p.rankSuffix} ${p.rankPhrase}`.trim();
}

/* Featured selection: lower weight wins. Ranked places first (honorable
   mentions weighted below podium places), then everything else by recency. */
function weightOf(p: ParsedTitle): number {
  if (!p.rank) return 99;
  const n = parseInt(p.rank, 10);
  return /honor/i.test(p.rankPhrase) ? n + 0.5 : n;
}

const entries = certificates.map((cert) => {
  const parsed = parseTitle(cert.title);
  const hasCredential = !!(cert.credentialUrl && cert.credentialUrl !== '#');
  return {
    cert,
    parsed,
    weight: weightOf(parsed),
    year: parseInt(cert.date) || 0,
    rankLabel: rankLabel(parsed),
    typeLabel: typeLabels[cert.type] || cert.type,
    hasCredential,
  };
});

const sorted = [...entries].sort((a, b) => a.weight - b.weight || b.year - a.year);
const featured = sorted[0] ?? null;
const ledger = sorted
  .slice(1)
  .sort((a, b) => b.year - a.year || a.weight - b.weight);

/* Ledger row display name: "Indoneris, Honorable Mention" / full title for courses */
function ledgerName(e: (typeof entries)[number]): string {
  if (!e.parsed.rank) return e.parsed.category;
  const suffix = /honor/i.test(e.parsed.rankPhrase) ? ', Honorable Mention' : '';
  return `${brandName(e.cert.issuer)}${suffix}`;
}
---

<section
  id="certificates"
  class="py-20 md:py-32 px-6 md:px-16 border-t border-[var(--border-color)]"
>
  <div class="max-w-[1600px] mx-auto">
    <SectionLabel number="05" label="Achievements" />

    <TextReveal
      tag="h2"
      animation="words"
      stagger={0.08}
      class="text-4xl md:text-5xl lg:text-7xl leading-[0.95] mb-16 md:mb-24 max-w-3xl"
    >
      Certificates &amp;
      <span class="italic text-[var(--accent-text)]">Awards</span>
    </TextReveal>

    {featured && (
      <div class="featured grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-24 items-center mb-20 md:mb-28">
        <div>
          <p class="featured-flag reveal-fade-up">Featured</p>
          <h3 class="featured-title reveal-fade-up" style="transition-delay: 100ms;">
            {featured.rankLabel ? (
              <>
                <em>{featured.rankLabel}</em>, {featured.parsed.category}
              </>
            ) : (
              featured.parsed.category
            )}
          </h3>
          <p class="featured-meta reveal-fade-up" style="transition-delay: 200ms;">
            {shortIssuer(featured.cert.issuer)}
            {issuerRest(featured.cert.issuer) && <br />}
            {issuerRest(featured.cert.issuer) && `${issuerRest(featured.cert.issuer)} · `}
            {!issuerRest(featured.cert.issuer) && ''}
            {featured.cert.date}
          </p>
          {featured.hasCredential && (
            <a
              class="featured-cta reveal-fade-up"
              style="transition-delay: 300ms;"
              href={featured.cert.credentialUrl}
              target="_blank"
              rel="noopener"
            >
              View credential
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          )}
        </div>

        {featured.cert.image && (
          <button
            type="button"
            class="featured-proof"
            data-lightbox-src={featured.cert.image}
            data-lightbox-alt={featured.cert.title}
            data-lightbox-caption={`${featured.rankLabel || featured.typeLabel} · ${featured.cert.date}`}
            aria-label={`View certificate: ${featured.cert.title}`}
          >
            <ImageReveal
              src={featured.cert.image}
              alt={featured.cert.title}
              direction="right"
              class="w-full h-full"
            />
          </button>
        )}
      </div>
    )}

    {ledger.length > 0 && (
      <ol class="ach-toc" id="achievement-ledger" role="list">
        {ledger.map((e) => (
          <li class="toc-row">
            {e.hasCredential ? (
              <a class="toc-line" href={e.cert.credentialUrl} target="_blank" rel="noopener">
                <span class="toc-title">
                  {e.parsed.rank && (
                    <span class="toc-rank">{e.parsed.rank}<sup>{e.parsed.rankSuffix}</sup></span>
                  )}
                  <span class="toc-name">{ledgerName(e)}</span>
                </span>
                <span class="toc-cat">{e.parsed.rank ? e.parsed.category : e.typeLabel}</span>
                <span class="toc-year">{e.cert.date}</span>
              </a>
            ) : (
              <button
                type="button"
                class="toc-line"
                data-lightbox-src={e.cert.image}
                data-lightbox-alt={e.cert.title}
                data-lightbox-caption={`${e.rankLabel || e.typeLabel} · ${e.cert.date}`}
                disabled={!e.cert.image}
              >
                <span class="toc-title">
                  {e.parsed.rank && (
                    <span class="toc-rank">{e.parsed.rank}<sup>{e.parsed.rankSuffix}</sup></span>
                  )}
                  <span class="toc-name">{ledgerName(e)}</span>
                </span>
                <span class="toc-cat">{e.parsed.rank ? e.parsed.category : e.typeLabel}</span>
                <span class="toc-year">{e.cert.date}</span>
              </button>
            )}
          </li>
        ))}
      </ol>
    )}

    <p class="ach-more reveal-fade">More to come.</p>
  </div>

  <!-- Minimal lightbox for entries without a credential URL -->
  <div id="cert-lightbox" class="cert-lightbox" role="dialog" aria-modal="true" aria-label="Certificate preview">
    <button type="button" class="lightbox-close" aria-label="Close preview">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <figure class="lightbox-figure">
      <img src="" alt="" />
      <figcaption></figcaption>
    </figure>
  </div>
</section>

<style>
  /* ===== Featured ===== */
  .featured-flag {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 1.5rem;
  }

  .featured-title {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 16ch;
    margin-bottom: 1.4rem;
  }
  .featured-title em {
    font-style: italic;
    color: var(--accent-text);
  }

  .featured-meta {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    line-height: 2.1;
    color: var(--text-secondary);
    margin-bottom: 1.8rem;
  }

  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
    text-decoration: none;
    transition: gap 350ms var(--ease-luxury);
  }
  .featured-cta:hover { gap: 1rem; }
  .featured-cta svg { width: 12px; height: 12px; }

  .featured-proof {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--duration-normal) var(--ease-luxury);
  }
  .featured-proof:hover { border-color: var(--accent); }
  .featured-proof:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 4px;
  }

  /* ===== Ledger ===== */
  .ach-toc {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-color);
  }

  .toc-row {
    border-bottom: 1px solid var(--border-color);
    /* GSAP entrance from-state */
    opacity: 0;
    transform: translateY(30px);
  }

  .toc-line {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 2rem;
    width: 100%;
    padding: 1.75rem 0.25rem;
    background: none;
    border: none;
    font: inherit;
    text-align: left;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .toc-line:disabled { cursor: default; }
  .toc-line:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 4px;
  }

  .toc-title {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .toc-rank {
    color: var(--accent-text);
    font-style: italic;
    font-weight: 600;
  }
  .toc-rank sup { font-size: 0.42em; font-style: normal; }
  .toc-name { transition: color 350ms var(--ease-luxury); }
  .toc-line:hover .toc-name { color: var(--accent-text); }

  .toc-cat,
  .toc-year {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--text-secondary);
    align-self: center;
    white-space: nowrap;
    transition: color 350ms var(--ease-luxury);
  }
  .toc-line:hover .toc-year { color: var(--accent-text); }

  .ach-more {
    margin-top: 3rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  /* ===== Lightbox ===== */
  .cert-lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 2rem;
    background: rgba(10, 10, 10, 0.88);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out-expo),
      visibility 0s linear 0.4s;
  }
  .cert-lightbox.open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(920px, 92vw);
    transform: scale(0.96) translateY(8px);
    transition: transform 0.5s var(--ease-out-expo);
  }
  .cert-lightbox.open .lightbox-figure {
    transform: scale(1) translateY(0);
  }
  .lightbox-figure img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    border: 1px solid rgba(249, 248, 246, 0.15);
  }
  .lightbox-figure figcaption {
    margin-top: 0.9rem;
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(249, 248, 246, 0.7);
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid rgba(249, 248, 246, 0.25);
    border-radius: 999px;
    color: #f9f8f6;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-luxury),
      color var(--duration-fast) var(--ease-luxury);
  }
  .lightbox-close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lightbox-close:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 4px;
  }
  .lightbox-close svg { width: 16px; height: 16px; }

  /* ===== Responsive ===== */
  @media (max-width: 720px) {
    .toc-line {
      grid-template-columns: 1fr auto;
      row-gap: 0.45rem;
    }
    .toc-cat {
      grid-column: 1 / -1;
      font-size: 9px;
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .toc-row {
      opacity: 1 !important;
      transform: none !important;
    }
    .cert-lightbox,
    .lightbox-figure {
      transition: none !important;
    }
    .lightbox-figure { transform: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/gsap-setup';

  function initAchievements() {
    const section = document.getElementById('certificates');
    if (!section || section.dataset.achInit === 'true') return;
    section.dataset.achInit = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controller = new AbortController();

    /* ===== Ledger entrance — staggered rise ===== */
    const ledger = section.querySelector<HTMLOListElement>('#achievement-ledger');
    const rows = ledger ? Array.from(ledger.querySelectorAll<HTMLLIElement>('.toc-row')) : [];

    if (rows.length) {
      if (reduced) {
        gsap.set(rows, { opacity: 1, y: 0 });
      } else {
        gsap.to(rows, {
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power3.out',
          stagger: 0.12,
          scrollTrigger: {
            id: 'achievement-ledger-reveal',
            trigger: ledger,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        });
      }
    }

    /* ===== Lightbox ===== */
    const lightbox = section.querySelector<HTMLElement>('#cert-lightbox');
    const lightboxImg = lightbox?.querySelector<HTMLImageElement>('img') ?? null;
    const lightboxCaption = lightbox?.querySelector<HTMLElement>('figcaption') ?? null;
    const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close') ?? null;
    let lastFocus: HTMLElement | null = null;
    let isOpen = false;

    function openLightbox(src: string, alt: string, caption: string) {
      if (!lightbox || !lightboxImg || isOpen) return;
      isOpen = true;
      lastFocus = document.activeElement as HTMLElement | null;

      lightboxImg.src = src;
      lightboxImg.alt = alt;
      if (lightboxCaption) lightboxCaption.textContent = caption;

      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
      (window as any).lenis?.stop?.();
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox || !isOpen) return;
      isOpen = false;
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
      (window as any).lenis?.start?.();
      lastFocus?.focus?.();
      lastFocus = null;
    }

    section.addEventListener('click', (e) => {
      const trigger = (e.target as Element)?.closest?.('[data-lightbox-src]') as HTMLElement | null;
      if (trigger && trigger.dataset.lightboxSrc) {
        e.preventDefault();
        openLightbox(
          trigger.dataset.lightboxSrc,
          trigger.dataset.lightboxAlt || '',
          trigger.dataset.lightboxCaption || '',
        );
      }
    }, { signal: controller.signal });

    lightbox?.addEventListener('click', (e) => {
      // Backdrop or close button dismisses; the figure itself does not.
      if (e.target === lightbox || (e.target as Element).closest('.lightbox-close')) {
        closeLightbox();
      }
    }, { signal: controller.signal });

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'Tab') {
        // Single focusable control inside the dialog — keep focus on it.
        e.preventDefault();
        closeBtn?.focus();
      }
    }, { signal: controller.signal });

    document.addEventListener('astro:before-swap', () => {
      closeLightbox();
      ScrollTrigger.getById('achievement-ledger-reveal')?.kill();
      gsap.killTweensOf(rows);
      controller.abort();
      delete section.dataset.achInit;
    }, { once: true, signal: controller.signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAchievements, { once: true });
  } else {
    initAchievements();
  }
  document.addEventListener('astro:after-swap', initAchievements);
</script>
