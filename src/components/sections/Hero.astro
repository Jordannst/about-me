---
import { personal, meta } from '../../data/portfolio';
import TextReveal from '../TextReveal.astro';
import BlurText from '../BlurText.astro';

// Rotating greeting languages — cycles via blur swap above the name.
// Order matters: starts on English, loops through to Mandarin, then back.
const greetings = [
  { lang: 'en', text: "Hello, I'm" },
  { lang: 'id', text: 'Halo, saya' },
  { lang: 'ja', text: 'こんにちは、私は' },
  { lang: 'es', text: 'Hola, soy' },
  { lang: 'zh', text: '你好，我是' },
];
---

<section class="min-h-screen flex items-center md:items-end pb-16 md:pb-32 pt-24 md:pt-32 px-8 md:px-16 relative overflow-hidden">
  <!-- Vertical Label (Desktop) -->
  <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2">
    <span class="vertical-text text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
      Portfolio / {meta.year}
    </span>
  </div>

  <div class="max-w-[1600px] mx-auto w-full">
    <!-- Decorative Line + Rotating Greeting -->
    <div class="flex items-center gap-4 mb-8 hero-line">
      <div class="h-px w-8 md:w-12 bg-[var(--border-strong)]"></div>
      <span class="hello-rotator" id="helloRotator" aria-live="polite" aria-atomic="true">
        {greetings.map((g, i) => (
          <span
            class:list={['hello-lang', i === 0 && 'active']}
            lang={g.lang}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            {g.text}
          </span>
        ))}
      </span>
    </div>

    <!-- Main Headline with TextReveal -->
    <div class="max-w-5xl">
      <TextReveal tag="h1" animation="chars" stagger={0.02} duration={1} class="text-5xl md:text-7xl lg:text-9xl leading-[0.9] mb-8 text-[var(--text-primary)]">
        {personal.name.split(' ')[0]}
        <br />
        <span class="text-[var(--text-secondary)]">{personal.name.split(' ')[1]}</span>
      </TextReveal>
      
      <!-- Tagline with BlurText (ReactBits-inspired blur-to-clear) -->
      <BlurText tag="p" delay={0.5} stagger={0.08} duration={0.8} class="font-[family-name:var(--font-serif)] text-2xl md:text-4xl lg:text-5xl leading-tight text-[var(--text-secondary)]">
        {personal.tagline}
        <span class="italic text-[var(--accent)]"> / {personal.taglineAccent}</span>
      </BlurText>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
    <div class="scroll-line-container">
      <div class="scroll-line"></div>
    </div>
  </div>
</section>

<style>
  /* ============================================
     Rotating Greeting (Hello, I'm — multilingual)
     Stacked grid: all langs share one cell, only
     .active is visible. Container auto-sizes to
     longest greeting so the line on the left
     never shifts position.
     ============================================ */
  .hello-rotator {
    display: inline-grid;
    grid-template-areas: 'stack';
    align-items: center;
  }

  .hello-lang {
    grid-area: stack;
    /* Latin default — conversational italic, brighter than utilitarian label.
       Bigger than the original 10px "Welcome" so the rotating phrase actually
       gets noticed, italic to feel personal/spoken rather than a static badge. */
    font-size: 16px;
    font-style: italic;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    white-space: nowrap;
    /* Hidden state */
    opacity: 0;
    filter: blur(8px);
    transition: opacity 0.5s ease, filter 0.5s ease;
    pointer-events: none;
    /* Don't let inactive langs push container width via baseline */
    line-height: 1.2;
  }

  .hello-lang.active {
    opacity: 1;
    filter: blur(0);
  }

  /* CJK rendering tweak — italic doesn't apply meaningfully to CJK glyphs
     and tracking should stay tight. Slight size bump for legibility parity. */
  .hello-lang[lang='ja'],
  .hello-lang[lang='ko'],
  .hello-lang[lang='zh'] {
    font-size: 18px;
    font-style: normal;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .hello-lang {
      transition: none;
    }
  }

  .scroll-indicator {
    opacity: 0;
    animation: fadeInDelayed 1s ease forwards;
    animation-delay: 2s;
  }

  .scroll-line-container {
    width: 1px;
    height: 48px;
    background: var(--border-color);
    position: relative;
    overflow: hidden;
  }

  .scroll-line {
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
    animation: scrollLine 2s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  @keyframes scrollLine {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    40% {
      transform: scaleY(1);
      transform-origin: top;
    }
    40.01% {
      transform-origin: bottom;
    }
    80%, 100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @keyframes fadeInDelayed {
    to { opacity: 1; }
  }

  /* Hide scroll indicator once user starts scrolling */
  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator {
      animation: none;
      opacity: 1;
    }
    .scroll-line {
      animation: none;
    }
  }
</style>

<script>
  // Hide scroll indicator on scroll
  let scrollIndicator: HTMLElement | null;
  function handleHeroScroll() {
    scrollIndicator = scrollIndicator || document.querySelector('.scroll-indicator');
    if (scrollIndicator && window.scrollY > 100) {
      scrollIndicator.style.opacity = '0';
      scrollIndicator.style.transition = 'opacity 0.5s ease';
    }
  }
  window.addEventListener('scroll', handleHeroScroll, { passive: true });

  // ============================================
  // Rotating Greeting — blur swap between languages
  // 2.5s display per language, 0.5s transition (CSS).
  // Pauses when tab hidden, respects prefers-reduced-motion,
  // re-inits cleanly on Astro view transitions.
  // ============================================
  let helloIntervalId: ReturnType<typeof setInterval> | null = null;

  function initHelloRotator() {
    // Clear any previous interval (Astro view transitions may re-run init)
    if (helloIntervalId !== null) {
      clearInterval(helloIntervalId);
      helloIntervalId = null;
    }

    const rotator = document.getElementById('helloRotator');
    if (!rotator) return;

    const items = Array.from(rotator.querySelectorAll('.hello-lang'));
    if (items.length < 2) return;

    // Respect reduced motion: stay frozen on first language
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let idx = 0;

    const advance = () => {
      const current = items[idx];
      current.classList.remove('active');
      current.setAttribute('aria-hidden', 'true');

      idx = (idx + 1) % items.length;

      const next = items[idx];
      next.classList.add('active');
      next.setAttribute('aria-hidden', 'false');
    };

    helloIntervalId = setInterval(advance, 2500);
  }

  // Pause cycling when tab is hidden, resume when visible
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (helloIntervalId !== null) {
        clearInterval(helloIntervalId);
        helloIntervalId = null;
      }
    } else {
      // Resume only if we were running before (rotator exists & not in reduced-motion)
      const rotator = document.getElementById('helloRotator');
      if (rotator && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (helloIntervalId === null) initHelloRotator();
      }
    }
  });

  document.addEventListener('DOMContentLoaded', initHelloRotator);
  document.addEventListener('astro:after-swap', initHelloRotator);
</script>
