---
import { personal, meta, social } from '../data/portfolio';
---

<!-- Minimal Footer for Inner Pages -->
<footer class="bg-[var(--bg-inverted)] text-[var(--text-inverted)]">
  <div class="py-8 px-8 md:px-16">
    <div class="max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <!-- Logo -->
        <div>
          <a href="/" class="font-[family-name:var(--font-serif)] text-xl tracking-tight hover:text-[var(--accent)] transition-colors duration-500">
            {personal.name.split(' ')[0]}<span class="text-[var(--accent)]">.</span>
          </a>
        </div>

        <!-- Back to Home -->
        <nav class="flex flex-wrap gap-6 md:justify-center">
          <a href="/" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Home
          </a>
          <a href="/#work" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Projects
          </a>
          <a href="/#contact" class="text-[10px] uppercase tracking-[0.2em] opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500">
            Contact
          </a>
        </nav>

        <!-- Social + Copyright -->
        <div class="flex flex-col md:items-end gap-4">
          <div class="flex items-center gap-5">
            <a href={social.github} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </a>
            <a href={social.linkedin} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect width="4" height="12" x="2" y="9"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
            <a href={social.instagram} target="_blank" rel="noopener" class="opacity-50 hover:opacity-100 hover:text-[var(--accent)] transition-all duration-500" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          </div>
          <p class="text-[9px] uppercase tracking-[0.2em] opacity-30">
            © {meta.year} {personal.name}
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
