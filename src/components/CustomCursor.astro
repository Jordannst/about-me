---
// CustomCursor.astro - Adaptive transparent arrow cursor
// Features: Classic arrow shape that adapts to light/dark backgrounds
---

<!-- Custom arrow cursor - adaptive style -->
<div id="cursor-arrow" class="cursor-arrow">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path 
      d="M5 3L19 12L12 13L9 20L5 3Z" 
      stroke="white" 
      stroke-width="2" 
      stroke-linejoin="round"
      fill="white"
    />
  </svg>
</div>

<style>
  .cursor-arrow {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-2px, -2px);
    transition: opacity 0.2s ease;
    will-change: transform, left, top;
    mix-blend-mode: difference;
  }

  .cursor-arrow svg {
    transition: transform 0.2s ease;
  }

  .cursor-arrow.hover svg {
    transform: scale(1.2);
  }

  .cursor-arrow.click svg {
    transform: scale(0.9);
  }

  .cursor-arrow.hidden {
    opacity: 0;
  }

  /* Hide on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .cursor-arrow {
      display: none !important;
    }
  }

  /* Hide default cursor on desktop */
  @media (hover: hover) and (pointer: fine) {
    :global(html) {
      cursor: none !important;
    }
    :global(a, button, [role="button"], input, textarea, select, label) {
      cursor: none !important;
    }
  }
</style>

<script>
  function initCursor() {
    const cursor = document.getElementById('cursor-arrow');
    if (!cursor) return;

    // Instant cursor follow - no delay
    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });

    // Hover effect on interactive elements
    const interactiveElements = 'a, button, [role="button"], input, textarea, select, label, .project-card, [data-cursor-hover]';

    document.querySelectorAll(interactiveElements).forEach(el => {
      el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });

    // Click effect
    document.addEventListener('mousedown', () => cursor.classList.add('click'));
    document.addEventListener('mouseup', () => cursor.classList.remove('click'));

    // Hide on mouse leave window
    document.addEventListener('mouseleave', () => cursor.classList.add('hidden'));
    document.addEventListener('mouseenter', () => cursor.classList.remove('hidden'));
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initCursor);
  document.addEventListener('astro:after-swap', initCursor);
</script>
