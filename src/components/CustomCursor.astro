---
// CustomCursor.astro - Adaptive transparent arrow cursor
// Features: Classic arrow shape that adapts to light/dark backgrounds
---

<!-- Custom arrow cursor - adaptive style -->
<div id="cursor-arrow" class="cursor-arrow">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path 
      d="M5 3L19 12L12 13L9 20L5 3Z" 
      stroke="white" 
      stroke-width="2" 
      stroke-linejoin="round"
      fill="white"
    />
  </svg>
</div>

<style>
  .cursor-arrow {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-2px, -2px);
    transition: opacity 0.2s ease;
    will-change: transform;
    mix-blend-mode: difference;
  }

  .cursor-arrow svg {
    transition: transform 0.2s ease;
  }

  .cursor-arrow.hover svg {
    transform: scale(1.2);
  }

  .cursor-arrow.click svg {
    transform: scale(0.9);
  }

  .cursor-arrow.hidden {
    opacity: 0;
  }

  /* Hide on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .cursor-arrow {
      display: none !important;
    }
  }

  /* Hide default cursor on desktop */
  @media (hover: hover) and (pointer: fine) {
    :global(html) {
      cursor: none !important;
    }
    :global(a, button, [role="button"], input, textarea, select, label) {
      cursor: none !important;
    }
  }
</style>

<script>
  // Track cleanup functions to avoid memory leaks on page navigation
  let cleanupCursor: (() => void) | null = null;

  function initCursor() {
    // Cleanup previous listeners before re-init
    if (cleanupCursor) {
      cleanupCursor();
      cleanupCursor = null;
    }

    const cursor = document.getElementById('cursor-arrow');
    if (!cursor) return;

    // Detect touch device and bail out
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches
      || 'ontouchstart' in window
      || navigator.maxTouchPoints > 0;

    if (isTouchDevice) {
      cursor.style.display = 'none';
      document.documentElement.style.cursor = '';
      return;
    }

    // Instant, lag-free cursor follow using hardware acceleration (transform)
    let animationFrameId: number;
    let mouseX = -100;
    let mouseY = -100;

    const onMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!animationFrameId) {
        animationFrameId = requestAnimationFrame(() => {
          cursor.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-2px, -2px)`;
          animationFrameId = 0;
        });
      }
    };

    const onMouseDown = () => cursor.classList.add('click');
    const onMouseUp = () => cursor.classList.remove('click');
    const onMouseLeave = () => cursor.classList.add('hidden');
    const onMouseEnter = () => cursor.classList.remove('hidden');

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);

    // Hover effect using event delegation (no per-element listeners)
    const interactiveSelector = 'a, button, [role="button"], input, textarea, select, label, .project-card, [data-cursor-hover]';
    const onDelegatedEnter = (e: MouseEvent) => {
      if ((e.target as Element)?.closest(interactiveSelector)) {
        cursor.classList.add('hover');
      }
    };
    const onDelegatedLeave = (e: MouseEvent) => {
      if ((e.target as Element)?.closest(interactiveSelector)) {
        cursor.classList.remove('hover');
      }
    };
    document.addEventListener('mouseover', onDelegatedEnter);
    document.addEventListener('mouseout', onDelegatedLeave);

    // Register cleanup
    cleanupCursor = () => {
      document.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mousedown', onMouseDown);
      document.removeEventListener('mouseup', onMouseUp);
      document.removeEventListener('mouseleave', onMouseLeave);
      document.removeEventListener('mouseenter', onMouseEnter);
      document.removeEventListener('mouseover', onDelegatedEnter);
      document.removeEventListener('mouseout', onDelegatedLeave);
    };
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initCursor);
  document.addEventListener('astro:after-swap', initCursor);
</script>
