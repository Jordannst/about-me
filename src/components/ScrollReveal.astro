---
// ScrollReveal - GSAP ScrollTrigger based scroll animations
// Unified with the same scroll system used by TextReveal and ImageReveal
---

<script>
  import { gsap, ScrollTrigger } from '../lib/gsap-setup';


  function initScrollReveal() {
    const revealElements = document.querySelectorAll(
      '.reveal:not(.revealed), .reveal-fade-up:not(.revealed), .reveal-fade:not(.revealed), .reveal-scale:not(.revealed), .reveal-left:not(.revealed), .reveal-right:not(.revealed)'
    );
    
    revealElements.forEach(el => {
      ScrollTrigger.create({
        trigger: el,
        start: 'top 88%',
        once: true,
        onEnter: () => {
          el.classList.add('revealed');
        }
      });
    });
  }

  // Initialize with small delay to ensure DOM readiness
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(initScrollReveal, 150);
  });
  document.addEventListener('astro:after-swap', () => {
    setTimeout(initScrollReveal, 150);
  });
</script>
