---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map(project => ({
    params: { id: String(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout>
  <Navigation />
  
  <main class="pt-24 md:pt-32 pb-20 md:pb-32">
    <!-- Back Link -->
    <div class="max-w-[1600px] mx-auto px-6 md:px-16 mb-8 md:mb-12">
      <a href="/#work" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500 reveal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Back to Projects</span>
      </a>
    </div>
    
    <!-- Project Content - All in One View -->
    <section class="max-w-[1600px] mx-auto px-6 md:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left: All Project Info -->
        <div class="lg:col-span-6 order-2 lg:order-1">
          <!-- Meta -->
          <div class="flex items-center gap-4 mb-4 reveal">
            <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--accent)]">
              {project.year || '2024'}
            </span>
            <div class="h-px w-8 bg-[var(--border-color)]"></div>
            <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
              {project.role || 'Developer'}
            </span>
          </div>
          
          <!-- Title -->
          <h1 class="font-[family-name:var(--font-serif)] text-3xl md:text-4xl lg:text-5xl leading-[0.95] text-[var(--text-primary)] mb-6 reveal-fade-up">
            {project.title}
          </h1>
          
          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-6 reveal-fade-up" style="transition-delay: 100ms;">
            {project.tags.map((tag: string) => (
              <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)] px-3 py-1 border border-[var(--border-color)]">
                {tag}
              </span>
            ))}
          </div>
          
          <!-- Overview / Description -->
          <div class="mb-8 reveal-fade-up" style="transition-delay: 150ms;">
            <h2 class="text-xs uppercase tracking-[0.25em] text-[var(--text-secondary)] mb-4">Overview</h2>
            <p class="text-base md:text-lg leading-relaxed text-[var(--text-primary)]">
              {project.longDescription || project.description}
            </p>
          </div>
          
          <!-- Links -->
          <div class="flex flex-wrap gap-4 reveal-fade-up" style="transition-delay: 200ms;">
            <a 
              href={project.link}
              target="_blank"
              rel="noopener"
              class="btn-primary px-6 py-3 inline-flex items-center gap-2"
            >
              <span class="text-xs uppercase tracking-[0.2em]">View Code</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              </svg>
            </a>
            {project.liveUrl && (
              <a 
                href={project.liveUrl}
                target="_blank"
                rel="noopener"
                class="px-6 py-3 border border-[var(--border-strong)] inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] hover:bg-[var(--bg-secondary)] transition-colors duration-500"
              >
                <span>Live Demo</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            )}
          </div>
          
          <!-- Back to All Projects -->
          <div class="mt-12 pt-8 border-t border-[var(--border-color)] reveal-fade" style="transition-delay: 250ms;">
            <a href="/#work" class="inline-flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500">
              <span>View all projects</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Right: Project Image -->
        <div class="lg:col-span-6 order-1 lg:order-2 reveal-fade-up">
          <div class="aspect-[4/3] bg-[var(--bg-secondary)] overflow-hidden relative lg:sticky lg:top-24">
            <div class="absolute inset-0 flex items-center justify-center text-[var(--text-secondary)]">
              <span class="text-xs uppercase tracking-[0.2em]">Project Image</span>
            </div>
            {/* Uncomment when image is available:
            <img 
              src={project.image} 
              alt={project.title}
              class="w-full h-full object-cover"
            />
            */}
          </div>
        </div>
        
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
