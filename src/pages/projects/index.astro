---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import FooterMinimal from '../../components/FooterMinimal.astro';
import { projects } from '../../data/portfolio';
---

<Layout>
  <Navigation />
  
  <main class="pt-24 md:pt-32 pb-20 md:pb-32">
    <!-- Header -->
    <section class="max-w-[1600px] mx-auto px-6 md:px-16 mb-16 md:mb-24">
      <!-- Back Link -->
      <a href="/" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-500 mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Back to Home</span>
      </a>
      
      <!-- Section Label -->
      <div class="flex items-center gap-4 mb-6">
        <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
          Archive
        </span>
        <div class="h-px w-8 bg-[var(--border-color)]"></div>
        <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--text-secondary)]">
          {projects.length} Projects
        </span>
      </div>
      
      <!-- Title -->
      <h1 class="text-4xl md:text-5xl lg:text-7xl leading-[0.95] text-[var(--text-primary)]">
        All
        <span class="italic text-[var(--accent)]">Projects</span>
      </h1>
    </section>
    
    <!-- Projects Grid -->
    <section class="max-w-[1600px] mx-auto px-6 md:px-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        {projects.map((project, index) => (
          <a
            href={`/projects/${project.id}`}
            class="project-card group block"
            data-cursor-text="View"
          >
            <!-- Project Image -->
            <div class="image-container aspect-video mb-4 overflow-hidden relative bg-[var(--bg-secondary)]">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              
              <!-- Hover Overlay -->
              <div class="absolute inset-0 bg-black/80 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500">
                <span class="text-xs uppercase tracking-[0.2em] text-white">View</span>
              </div>
            </div>

            <!-- Project Info -->
            <div>
              <div class="flex items-start justify-between mb-2">
                <h3 class="text-lg md:text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors duration-500">
                  {project.title}
                </h3>
                <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)]">
                  {project.year}
                </span>
              </div>
              
              <p class="text-sm text-[var(--text-secondary)] mb-3 line-clamp-2">
                {project.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1">
                {project.tags.slice(0, 3).map((tag) => (
                  <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--text-secondary)] px-2 py-0.5 border border-[var(--border-color)]">
                    {tag}
                  </span>
                ))}
                {project.tags.length > 3 && (
                  <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--text-secondary)] px-2 py-0.5">
                    +{project.tags.length - 3}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
        
        <!-- Coming Soon Card -->
        <div class="coming-soon-card aspect-video mb-4 flex flex-col items-center justify-center border border-dashed border-[var(--border-color)] bg-[var(--bg-secondary)]/30">
          <div class="text-center p-6">
            <div class="w-12 h-12 mx-auto mb-4 border border-[var(--accent)] rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-[var(--accent)]">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </div>
            <p class="font-[family-name:var(--font-serif)] text-lg text-[var(--text-primary)] mb-1">
              More to <span class="italic text-[var(--accent)]">Come</span>
            </p>
            <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Stay tuned
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <FooterMinimal />
</Layout>

<style>
  .image-container {
    transition: transform 400ms ease, box-shadow 400ms ease;
  }
  
  .project-card:hover .image-container {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
