---
import { meta } from '../data/portfolio';
import '../styles/global.css';
import GridLines from '../components/GridLines.astro';
import NoiseTexture from '../components/NoiseTexture.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import PageTransition from '../components/PageTransition.astro';
import BackToTop from '../components/BackToTop.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import CustomCursor from '../components/CustomCursor.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logotab.webp" />
    <link rel="apple-touch-icon" href="/logotab.webp" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Jordan Sutarto" />
    <link rel="canonical" href="https://www.jordannst.my.id/" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.jordannst.my.id/" />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:site_name" content="Jordan Sutarto" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content="/logo.png" />

    <!-- Theme Color (dynamic) -->
    <meta name="theme-color" content="#F9F8F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1A1A" media="(prefers-color-scheme: dark)" />

    <!-- Anti-Flash Script: Runs immediately before page renders -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme-preference');
        // Default to dark theme, only use light if explicitly stored
        const theme = stored || 'dark';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen transition-colors duration-700">
    <!-- Loading Screen -->
    <LoadingScreen />
    
    <!-- Scroll Progress Indicator -->
    <ScrollProgress />
    
    <!-- Custom Interactive Cursor -->
    <CustomCursor />
    
    <!-- Page Transition Overlay -->
    <PageTransition />
    
    <!-- Noise Texture Overlay -->
    <NoiseTexture />
    
    <!-- Visible Grid Lines -->
    <GridLines />
    
    <!-- Main Content -->
    <slot />
    
    <!-- Back to Top Button -->
    <BackToTop />
    
    <!-- Scroll Reveal Script -->
    <ScrollReveal />
  </body>
</html>
